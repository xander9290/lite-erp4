import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { readFile } from "node:fs/promises";
import type { ModuleOperationPlan, OperationResult } from "./src/lib/module-manager/operation.types";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { modelService, modelClientConfig, getModuleModel, withActor, relationQuickCreate } = await import("./src/lib/modules/registry");
const { createModelImageSigner } = await import("./src/lib/uploads/model-image.server");
const { authorizeModel } = await import("./src/lib/access/engine");
const { hashPassword } = await import("./src/lib/auth/password");

// Disposable accounts in the temporary schema only.
const password = await hashPassword("extension-test-only");
const root = await prisma.user.create({ data: { login: "extension-root", password, isAdmin: true } });
const reader = await prisma.user.create({ data: { login: "extension-reader", password } });
await prisma.accessUserGroup.create({ data: { userId: reader.id, groupId: "taller.lector" } });
const actor = { id: root.id, sessionVersion: root.sessionVersion };
const lector = { id: reader.id, sessionVersion: reader.sessionVersion };
const technician = await prisma.user.create({ data: { login: "extension-tech", password } });
await prisma.accessUserGroup.create({ data: { userId: technician.id, groupId: "soporte.tecnico" } });
const tecnico = { id: technician.id, sessionVersion: technician.sessionVersion };
type Saved = Record<string, unknown> & { id: string; revision: string };
const ok = <T extends { ok: boolean }>(result: T, step: string) => { assert.ok(result.ok, `${step}: ${JSON.stringify(result)}`); return result as T & { values: Saved }; };
const equipos = modelService("taller.equipo");
const defaults = getModuleModel("taller.equipo")!.entry.contract.createDefaults();
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };
const listOf = async (request: Record<string, unknown> = {}, who = actor) => {
  const result = await withActor(who, () => equipos.list(prisma, who, { ...state, ...request }));
  assert.ok(result.ok, JSON.stringify(result));
  return result.data;
};
// Raw SQL for the companion table: after the extension is dropped its Prisma delegate no
// longer exists, and the module manager type-checks the whole project.
const schema = new URL(process.env.DATABASE_URL!).searchParams.get("schema")!;
assert.match(schema, /^modules_test_[a-f0-9]+$/);
const companionTable = `"${schema}"."soporte_taller_equipo"`;
type Companion = { recordId: string; nivel: number; createBy: string | null };
const companions = () => prisma.$queryRawUnsafe<Companion[]>('SELECT record_id AS "recordId", nivel, create_by AS "createBy" FROM ' + companionTable + ' ORDER BY id');
const companionOf = async (id: string) => (await companions()).filter(row => row.recordId === id);

// A record that existed before Soporte was installed has no companion row: defaults are shown.
const legacyId = (process.argv[2] ?? "").trim();
assert.ok(legacyId, "falta el registro previo a la extensión");
const legacy = ok(await equipos.read(prisma, actor, legacyId), "leer registro previo");
assert.equal(legacy.values.name, "PREVIO");
assert.equal(legacy.values.responsable, null);
assert.equal(legacy.values.nivel, 1);
assert.deepEqual(legacy.values.marcas, [], "sin fila compañera no hay vínculos");
assert.equal((await companions()).length, 0);
const initial = await listOf();
assert.equal(initial.rows[0].nivel, null, "collections use empty storage semantics before a companion exists");
assert.equal(initial.rows[0].etiqueta, null, "compute with a missing required storage dependency is empty");
assert.deepEqual((await listOf({ groupBy: ["nivel"] })).groups?.map(group => [group.value, group.count]), [[null, 1]]);
assert.equal((await listOf({ filters: [{ field: "nivel", operator: "empty" }] })).total, 1);
assert.equal((await listOf({ filters: [{ field: "nivel", operator: "notEmpty" }] })).total, 0);
assert.equal((await listOf({ groupBy: ["nivel"], groupPath: [null] })).total, 1);
assert.equal((await equipos.read(prisma, tecnico, legacyId)).ok, false, "rules do not treat missing storage as the form default");

// Saving it creates the companion row in the same write and advances the single revision.
const updated = ok(await equipos.save(prisma, actor, { ...legacy.values, responsable: "Ana", nivel: 2 }), "guardar con campos extendidos");
assert.notEqual(updated.values.revision, legacy.values.revision);
assert.equal(updated.values.responsable, "Ana");
const [row] = await companions();
assert.equal(row.recordId, legacyId);
assert.equal(row.nivel, 2);
assert.equal((await equipos.save(prisma, actor, { ...legacy.values, nivel: 3 })).ok, false, "revisión vieja rechazada");
assert.equal((await companions())[0].nivel, 2, "el rechazo no toca la fila compañera");

// Create: base rule (uppercase, from the base class) and extension rule (super) both apply.
const created = ok(await equipos.save(prisma, actor, { ...defaults, name: "taladro", estado: "activo", responsable: "Luis", nivel: 1, codigo: "T-1", logo: "https://example.com/logo.png", equipoId: legacyId }), "crear");
assert.equal(created.values.name, "TALADRO");
assert.equal((await companionOf(created.values.id))[0]?.createBy, actor.id);
const before = await companions(), baseBefore = await prisma.tallerEquipo.findMany({ orderBy: { id: "asc" } });
const rejected = await equipos.save(prisma, actor, { ...created.values, estado: "baja", responsable: null });
assert.ok(!rejected.ok && "fieldErrors" in rejected && rejected.fieldErrors?.responsable, JSON.stringify(rejected));
assert.deepEqual(await companions(), before, "una regla de la extensión revierte también la base");
assert.deepEqual(await prisma.tallerEquipo.findMany({ orderBy: { id: "asc" } }), baseBefore);

// Actions declared by the extension write companion fields through the same pipeline.
const escalated = ok(await equipos.action(prisma, actor, { action: "escalar", id: created.values.id, revision: created.values.revision }), "acción de la extensión");
assert.equal(escalated.values.nivel, 2);
const history = ok(await equipos.activity(prisma, actor, { id: created.values.id }), "historial") as unknown as { data: { entries: { kind: string; changes: { field: string; after: unknown }[] }[] } };
assert.ok(history.data.entries.some(entry => entry.kind === "update" && entry.changes.some(change => change.field === "nivel" && change.after === 2)), JSON.stringify(history.data.entries));

// Access and rules are those of the base model: a reader sees extension fields but cannot write.
const read = ok(await equipos.read(prisma, lector, created.values.id), "lectura del lector");
assert.equal(read.values.responsable, "Luis");
assert.equal((await equipos.save(prisma, lector, { ...read.values, responsable: "Otro" })).ok, false, "lector no escribe campos extendidos");

// Client contract and server-resolved lazy view: no loaders/functions in browser config.
const client = modelClientConfig("taller.equipo");
assert.deepEqual(client.extensions, [{ module: "soporte", label: "Soporte", fields: ["responsable", "nivel", "logo", "codigo", "equipoId", "etiqueta", "nombreEquipo", "responsableEquipo", "imagenEquipo", "marcas"], depends: ["taller"] }]);
assert.deepEqual(client.many2many?.marcas?.target, "SoporteMarca");
assert.equal(client.lookups.marcas, "soporte.marca");
assert.ok(client.fields.responsable && client.preview.etiqueta);
assert.ok(client.list.fields.includes("responsable") && client.list.fields.includes("nombreEquipo"));
assert.equal(typeof getModuleModel("taller.equipo")!.entry.extensions[0].views?.form, "function");
assert.doesNotMatch(JSON.stringify(client), /views|loader|apiSecret/);
assert.deepEqual(client.actions, [{ name: "escalar", label: "Escalar" }]);
const list = await listOf();
assert.equal(list.rows.length, 2);
assert.equal(list.rows.find(row => row.id === created.values.id)?.nombreEquipo, "PREVIO");
assert.equal(list.rows.find(row => row.id === created.values.id)?.responsableEquipo, "Ana", "related can project a target extension field");
assert.equal((await listOf({ query: "Luis" })).total, 1, "search on a companion field");
assert.equal((await listOf({ sort: "nivel", direction: "desc" })).rows.length, 2);
assert.equal((await listOf({ filters: [{ field: "nivel", operator: "eq", value: "2" }] })).total, 2);
assert.deepEqual((await listOf({ groupBy: ["nivel"] })).groups?.map(group => [group.value, group.count]), [[2, 2]]);
assert.equal((await listOf({ groupBy: ["nivel", "responsable"], groupPath: [2] })).groups?.length, 2);
assert.deepEqual(client.collectionViews, ["list", "card", "kanban"]);
const board = await withActor(actor, () => equipos.kanban(prisma, actor, { group: "activo", state }));
assert.ok(board.ok && board.data.rows.some(row => row.logo === "https://example.com/logo.png" && row.responsable === "Luis"), JSON.stringify(board));
const domain = equipos.defineListAction({ domain: [{ field: "responsable", operator: "eq", value: "Luis" }] });
const fixed = await withActor(actor, () => domain(prisma, actor, state));
assert.ok(fixed.ok && fixed.data.total === 1, JSON.stringify(fixed));
const lookup = await equipos.lookup(prisma, actor, { query: "Luis" });
assert.ok(lookup.ok && lookup.items.length === 1 && lookup.items[0].value === created.values.id, JSON.stringify(lookup));

// Unique constraints roll back both tables and preserve the revision on failure.
const prior = ok(await equipos.read(prisma, actor, legacyId), "prior unique");
const duplicate = await equipos.save(prisma, actor, { ...prior.values, name: "NO GUARDAR", codigo: "T-1" });
assert.ok(!duplicate.ok && /únicos/.test(duplicate.error), JSON.stringify(duplicate));
const afterUnique = ok(await equipos.read(prisma, actor, legacyId), "after unique");
assert.equal(afterUnique.values.name, prior.values.name);
assert.equal(afterUnique.values.revision, prior.values.revision);

// The extension's rule targets the base: read/list/lookup/write/create all use it.
const hidden = ok(await equipos.save(prisma, actor, { ...defaults, name: "oculto", estado: "activo", responsable: "Ana", nivel: 3 }), "hidden");
assert.equal((await equipos.read(prisma, tecnico, hidden.values.id)).ok, false);
assert.equal((await listOf({}, tecnico)).total, 2);
const hiddenLookup = await equipos.lookup(prisma, tecnico, { id: hidden.values.id });
assert.ok(hiddenLookup.ok && hiddenLookup.items.length === 0, JSON.stringify(hiddenLookup));
const visible = ok(await equipos.read(prisma, tecnico, legacyId), "visible to technician");
assert.equal((await equipos.save(prisma, tecnico, { ...visible.values, nivel: 3 })).ok, false, "post-write scope rolls back a forbidden level");
assert.equal(ok(await equipos.read(prisma, actor, legacyId), "rollback level").values.nivel, 2);
assert.equal((await equipos.save(prisma, tecnico, { ...defaults, name: "forjado", nivel: 3 })).ok, false);
const masked = await withActor(tecnico, () => equipos.react(prisma, tecnico, { field: "equipoId", values: { equipoId: hidden.values.id } }));
assert.ok(masked.ok && masked.preview.nombreEquipo === null && masked.preview.responsableEquipo === null, JSON.stringify(masked));

// Sign an extension image using fake configuration; no external upload is performed.
let authorized = 0;
const sign = createModelImageSigner({ authorize: async () => { authorized++; }, getConfig: () => ({ cloudName: "fixture", apiKey: "123", apiSecret: "test-only" }) }, { metadata: client.fields }, Object.keys(client.fields));
const signed = await sign("logo");
assert.ok(signed.ok && signed.data.parameters.asset_folder === "extension-fixture", JSON.stringify(signed));
assert.equal(authorized, 1);
assert.equal((await sign("nombreEquipo")).ok, false, "related is not an upload target");
const deniedSign = createModelImageSigner({ authorize: () => prisma.$transaction(tx => authorizeModel(tx, lector, "taller.equipo", "write")), getConfig: () => { throw new Error("must authorize before reading secrets"); } }, { metadata: client.fields }, Object.keys(client.fields));
assert.equal((await deniedSign("logo")).ok, false, "a read-only account cannot upload an extension image");
ok(await equipos.remove(prisma, actor, [{ id: hidden.values.id, revision: hidden.values.revision }]), "cleanup hidden");

// Many2many declared by the extension: links stored through the companion row.
const marcas = modelService("soporte.marca");
const marcaDefaults = getModuleModel("soporte.marca")!.entry.contract.createDefaults();
const m1 = ok(await marcas.save(prisma, actor, { ...marcaDefaults, name: "Bosch" }), "marca 1").values.id;
const m2 = ok(await marcas.save(prisma, actor, { ...marcaDefaults, name: "Makita" }), "marca 2").values.id;
const linksTable = `"${schema}"."soporte_taller_equipo_marcas_rel"`;
const links = async () => (await prisma.$queryRawUnsafe<{ n: number }[]>("SELECT count(*)::int AS n FROM " + linksTable))[0].n;
const tagged = ok(await equipos.save(prisma, actor, { ...defaults, name: "esmeril", estado: "activo", nivel: 1, marcas: [m2, m1] }), "crear con marcas");
assert.deepEqual(tagged.values.marcas, [m1, m2].sort(), "lectura ordenada por ID");
assert.equal(await links(), 2);
assert.equal((await companionOf(tagged.values.id)).length, 1, "la fila compañera se crea con los vínculos");
const onlyLinks = ok(await equipos.save(prisma, actor, { ...tagged.values, marcas: [m2] }), "sólo cambiar vínculos");
assert.notEqual(onlyLinks.values.revision, tagged.values.revision, "cambiar vínculos avanza la revisión del base");
assert.deepEqual(onlyLinks.values.marcas, [m2]);
assert.equal(await links(), 1);
const taggedHistory = ok(await equipos.activity(prisma, actor, { id: tagged.values.id }), "historial de vínculos") as unknown as { data: { entries: { kind: string; summary?: string }[] } };
assert.ok(JSON.stringify(taggedHistory.data.entries).includes("Relaciones actualizadas"), JSON.stringify(taggedHistory.data.entries));
assert.equal((await equipos.save(prisma, actor, { ...onlyLinks.values, marcas: ["no-existe"] })).ok, false, "ID inexistente rechazado");
assert.equal((await equipos.save(prisma, actor, { ...onlyLinks.values, marcas: [m1, m1] })).ok, false, "IDs repetidos rechazados");
assert.equal(await links(), 1, "los rechazos no tocan los vínculos");
assert.equal((await equipos.read(prisma, lector, tagged.values.id)).ok, false, "un vínculo ilegible para el actor bloquea la apertura");
const m2Record = ok(await marcas.read(prisma, actor, m2), "leer marca usada");
assert.equal((await marcas.remove(prisma, actor, [{ id: m2, revision: m2Record.values.revision }])).ok, false, "una marca en uso no se borra (Restrict)");
const taggedNow = ok(await equipos.read(prisma, actor, tagged.values.id), "releer etiquetado");
ok(await equipos.remove(prisma, actor, [{ id: taggedNow.values.id, revision: taggedNow.values.revision }]), "borrar etiquetado");
assert.equal(await links(), 0, "borrar el registro base borra compañera y vínculos (Cascade)");
console.log("✓ Many2many de extensión: tabla del extensor colgada de la compañera, lectura/escritura en la misma revisión, rechazos, Restrict y Cascade.");

// «Crear» from the selector (create: true): only the name, through the target service.
assert.equal(modelClientConfig("taller.equipo").many2many?.marcas?.create, true);
const quick = await relationQuickCreate("taller.equipo", "marcas", actor, "  Hilti   Pro ");
assert.ok(quick.ok && quick.created && quick.item.label === "Hilti Pro", JSON.stringify(quick));
const reused = await relationQuickCreate("taller.equipo", "marcas", actor, "hilti pro");
assert.ok(reused.ok && !reused.created && quick.ok && reused.item.value === quick.item.value, "un nombre existente se reutiliza (sin distinguir mayúsculas)");
assert.equal((await relationQuickCreate("taller.equipo", "marcas", actor, "   ")).ok, false, "texto vacío rechazado");
assert.equal((await relationQuickCreate("taller.equipo", "marcas", lector, "Nueva")).ok, false, "sin permiso de crear en el destino no se crea");
await assert.rejects(() => relationQuickCreate("taller.equipo", "equipoId", actor, "X"), /no publicada/, "sólo Many2many declarados con create");
assert.equal((await prisma.$queryRawUnsafe<{ n: number }[]>(`SELECT count(*)::int AS n FROM "${schema}"."soporte_marca" WHERE name = 'Hilti Pro'`))[0].n, 1);
console.log("✓ Crear desde el selector: alta sólo con nombre por el servicio del destino, reutiliza nombres existentes y respeta permisos.");
// Many2many in collections: filter by membership/emptiness, IDs and names per row.
const quickId = quick.ok ? quick.item.value : "";
const both = ok(await equipos.save(prisma, actor, { ...defaults, name: "lija", estado: "activo", nivel: 1, marcas: [m1, m2] }), "lista con dos marcas");
const one = ok(await equipos.save(prisma, actor, { ...defaults, name: "pulidora", estado: "activo", nivel: 1, marcas: [quickId] }), "lista con una marca");
const ids = (result: Awaited<ReturnType<typeof listOf>>) => result.rows.map(row => row.id).sort();
const total = (await listOf()).total;
assert.deepEqual(ids(await listOf({ filters: [{ field: "marcas", operator: "any", value: `${m1},${quickId}` }] })), [both.values.id, one.values.id].sort());
assert.deepEqual(ids(await listOf({ filters: [{ field: "marcas", operator: "all", value: `${m1},${m2}` }] })), [both.values.id]);
assert.equal((await listOf({ filters: [{ field: "marcas", operator: "notEmpty" }] })).total, 2);
assert.equal((await listOf({ filters: [{ field: "marcas", operator: "empty" }] })).total, total - 2, "sin fila compañera o sin vínculos cuenta como vacío");
const taggedRow = (await listOf({ filters: [{ field: "marcas", operator: "all", value: `${m1},${m2}` }] })).rows[0];
assert.deepEqual(taggedRow.marcas, [m1, m2].sort());
assert.deepEqual(((taggedRow.$labels as Record<string, { label: string }[]>).marcas).map(item => item.label).sort(), ["Bosch", "Makita"]);
const filterRejected = async (filters: unknown[], who = actor) => (await withActor(who, () => equipos.list(prisma, who, { ...state, filters }))).ok;
assert.equal(await filterRejected([{ field: "marcas", operator: "eq", value: m1 }]), false, "sólo alguna/todas/vacío");
assert.equal(await filterRejected([{ field: "marcas", operator: "any", value: Array.from({ length: 11 }, (_, index) => `x${index}`).join(",") }]), false, "máximo 10 IDs");
assert.equal(await filterRejected([{ field: "marcas", operator: "any", value: "no-existe" }]), false, "IDs inexistentes rechazados");
assert.equal(await filterRejected([{ field: "marcas", operator: "any", value: m1 }], lector), false, "IDs que el actor no puede leer rechazados");
for (const record of [both, one]) {
  const current = ok(await equipos.read(prisma, actor, record.values.id), "releer para borrar");
  ok(await equipos.remove(prisma, actor, [{ id: current.values.id, revision: current.values.revision }]), "limpiar");
}
console.log("✓ Many2many en colecciones: filtros alguna/todas/vacío/con valor, IDs y nombres por fila, rechazos de operador, límite y acceso.");


await (await import("./extension-render")).verifyExtensionForm();

// Deleting the base record deletes its companion row (Cascade).
const current = ok(await equipos.read(prisma, actor, created.values.id), "releer");
ok(await equipos.remove(prisma, actor, [{ id: current.values.id, revision: current.values.revision }]), "borrar");
assert.equal((await companionOf(created.values.id)).length, 0);
assert.equal((await companions()).length, 1);

// Module manager: the base cannot be uninstalled while extended; dropping the extension only
// drops its companion table and the inverse it owns inside the base schema.
const request = (body: Record<string, unknown>): OperationResult => {
  const result = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", "scripts/module-operation.ts", "--worker"], { cwd: process.cwd(), env: process.env, input: JSON.stringify({ ...body, actor }), encoding: "utf8", timeout: 300000 });
  if (result.error) throw result.error;
  const marker = result.stdout.lastIndexOf("MODULE_OPERATION_RESULT:");
  assert.ok(marker >= 0, result.stdout + result.stderr);
  return JSON.parse(result.stdout.slice(marker + "MODULE_OPERATION_RESULT:".length).trim());
};
const plan = (result: OperationResult): ModuleOperationPlan => { assert.ok(result.ok, JSON.stringify(result)); return result.plan; };
const base = plan(request({ command: "review", input: { module: "taller", operation: "uninstall", policy: "keep" } }));
assert.ok(base.blockers.length > 0, "desinstalar el base queda bloqueado por la extensión");
let drop = plan(request({ command: "review", input: { module: "soporte", operation: "uninstall", policy: "drop" } }));
assert.deepEqual(drop.blockers, [], JSON.stringify(drop));
assert.match(drop.sql, /DROP TABLE "soporte_taller_equipo"/);
assert.match(drop.sql, /DROP TABLE "soporte_taller_equipo_marcas_rel"/);
assert.doesNotMatch(drop.sql, /DROP TABLE "taller_equipo"|ALTER TABLE "taller_equipo" DROP COLUMN/);
drop = plan(request({ command: "apply", id: drop.id, fingerprint: drop.fingerprint, confirmedModule: "soporte", maintenanceConfirmed: true }));
assert.equal(drop.phase, "complete", JSON.stringify(drop));
plan(request({ command: "finish", id: drop.id, maintenanceConfirmed: true }));
assert.equal((await prisma.$queryRawUnsafe<{ name: string | null }[]>("SELECT to_regclass($1)::text AS name", `${schema}.soporte_taller_equipo`))[0].name, null);
assert.equal(await prisma.tallerEquipo.count(), 1, "los datos del base se conservan");
assert.doesNotMatch(await readFile("prisma/models/orm-taller.prisma", "utf8"), /lite-erp:soporte/);
assert.equal(JSON.parse(await readFile("prisma/.orm-installations.json", "utf8")).modules.soporte, undefined);
await prisma.$disconnect();
console.log("✓ Gestor: desinstalar el base bloqueado; eliminar la extensión borra sólo su tabla compañera y su inversa, con respaldo.");
console.log("✓ Extensión: campos en tabla compañera, defaults sin fila previa, una revisión, super en hooks, acción, historial, accesos del base y borrado en cascada.");
