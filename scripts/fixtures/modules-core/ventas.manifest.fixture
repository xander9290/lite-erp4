import "server-only";
import { Fields, Model } from "@/lib/orm";
import { defineModule } from "@/lib/modules/define";

/** Relates to the native User without declaring core (implicit dependency). */
class Cliente extends Model {
  name = Fields.Text({ label: "Nombre", required: true, maxLength: 80 });
  contactoId = Fields.Many2one("User", { label: "Contacto", tracking: true });
  responsableId = Fields.Many2one("User", { label: "Responsable" });
}

export default defineModule({ id: "ventas", name: "Ventas", icon: "store", models: { cliente: Cliente } });
