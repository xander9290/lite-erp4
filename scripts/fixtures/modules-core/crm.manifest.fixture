import "server-only";
import { Fields } from "@/lib/orm";
import { defineModule } from "@/lib/modules/define";
import { extendModel } from "@/lib/modules/extend";
import { User } from "@/lib/core/models/user";

/** Extends the native User: its fields live in crm_core_user, owned by this module. */
const UserCrm = extendModel(User, Base => {
  class UserCrm extends Base {
    empresa = Fields.Text({ label: "Empresa", maxLength: 80, tracking: true });
  }
  return UserCrm;
});

export default defineModule({ id: "crm", name: "CRM", icon: "users", models: {}, extends: { "core.user": UserCrm } });
