import type { ReactionValues,ReactionContext,ModelContext } from "./src/lib/orm";
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { recordModel } = await import("./src/app/(auth)/erp/ensayo-framework/models/Record");
const { recordService } = await import("./src/app/(auth)/erp/ensayo-framework/models/record.service");
const { EnsayoFrameworkRecordRepository } = await import("./src/generated/orm/bindings/ensayo-framework/EnsayoFrameworkRecord.store");
const { createModelService } = await import("./src/lib/orm/service");
const { unboundRepository } = await import("./src/lib/orm/repository");
const { deleteRegisteredRecords } = await import("./src/lib/list/delete-registry");
const { hashPassword } = await import("./src/lib/auth/password");
const { createEnsayoFrameworkRecordDefaults, EnsayoFrameworkRecordRecordSchema } = await import("./src/generated/orm/apps/ensayo-framework/EnsayoFrameworkRecord.schema");
const service = createModelService(recordModel, EnsayoFrameworkRecordRepository, {
  columns: [
    { field: "name", label: "Nombre", type: "text", sortable: true },
    { field: "active", label: "Activo", type: "boolean", sortable: true, groupable: true },
    { field: "quantity", label: "Cantidad", type: "integer", sortable: true },
    { field: "startsAt", label: "Fecha", type: "datetime", sortable: true },
    { field: "status", label: "Estado", type: "text", sortable: true, groupable: true },
    { field: "notes", label: "Notas", type: "text", sortable: true, groupable: true },
    { field: "partnerId", label: "Contacto", type: "text", sortable: true },
    { field: "createByUser.login", label: "Creado por", type: "text", widget: "partner", avatarField: "createByUser.partner.avatarUrl", sortable: true },
    { field: "createByUser.partner.name", label: "Nombre del creador", type: "text", sortable: true },
    { field: "createdAt", label: "Creado el", type: "datetime", sortable: true },
    { field: "updatedAt", label: "Actualizado el", type: "datetime", sortable: true },
  ], searchFields: ["name", "notes", "createByUser.login", "createByUser.partner.name"], kanban: { field: "status" }, audit: true,
});
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };
try {
  const admin = await prisma.user.findUniqueOrThrow({ where: { login: "fixture-admin" } });
  const reader = await prisma.user.create({ data: { login: "fixture-reader", password: await hashPassword("framework-test-only"), isAdmin: false } });
  const actor = { id: admin.id, sessionVersion: admin.sessionVersion };
  const partner = await prisma.partner.create({ data: { name: "Contacto del ensayo" } });
  const before = await prisma.ensayoFrameworkRecord.findFirstOrThrow({ where: { name: "Registro anterior" } });
  assert.equal(before.quantity, 0); assert.equal(before.notes, null); assert.equal(before.status, "draft");
  const defaults = createEnsayoFrameworkRecordDefaults();
  assert.equal(EnsayoFrameworkRecordRecordSchema.safeParse({ ...defaults, name: "Desde formulario" }).success, true);
  const created = await service.save(prisma, actor, { ...defaults, name: "Registro de prueba", quantity: "12", startsAt: "2026-11-07T23:59:00.000Z", partnerId: partner.id });
  assert.ok(created.ok, JSON.stringify(created));
  const lookup = await service.lookup(prisma, actor, { id: created.values.id });
  assert.ok(lookup.ok, JSON.stringify(lookup));
  assert.deepEqual(lookup.items, [{ value: created.values.id, label: created.values.name, record: { id: created.values.id } }]);
  const searchedLookup = await service.lookup(prisma, actor, { query: "Registro prueba", pageSize: 1, page: 999 });
  assert.ok(searchedLookup.ok); assert.equal(searchedLookup.total, 1); assert.equal(searchedLookup.page, 1);
  const batchLookup = await service.lookup(prisma, actor, { ids: [created.values.id, before.id], pageSize: 1 });
  assert.ok(batchLookup.ok); assert.equal(batchLookup.items.length, 2);
  assert.equal((await service.lookup(prisma, { id: reader.id, sessionVersion: reader.sessionVersion }, {})).ok, false);
  assert.equal((await service.lookup(prisma, actor, { displayName: "{notes}" })).ok, false);
  const namedService = createModelService({ ...recordModel, displayFields: ["name", "quantity"], displayName: row => `${row.name} · ${row.quantity}` }, EnsayoFrameworkRecordRepository, {
    columns: [{ field: "name", label: "Nombre" }], searchFields: ["name"],
  });
  const namedLookup = await namedService.lookup(prisma, actor, { id: created.values.id });
  assert.ok(namedLookup.ok, JSON.stringify(namedLookup));
  assert.deepEqual(namedLookup.items, [{ value: created.values.id, label: `${created.values.name} · 12`, record: { id: created.values.id } }]);
  assert.equal(created.values.startsAt, "2026-11-07T23:59:00.000Z");
  assert.equal(created.values.partnerId, partner.id);
  const { createQueryActions } = await import("./src/lib/orm/query-actions");
  let authorizations = 0;
  const queries = createQueryActions({ prisma, authorize: async () => { authorizations++; return actor; } }, { read: service.read, list: service.list });
  const queryRead = await queries.read(created.values.id); assert.ok(queryRead.ok);
  const queryList = await queries.list(state); assert.ok(queryList.ok);
  assert.equal(authorizations, 2);

  assert.equal(Object.hasOwn(created.values, "partner"), false);
  assert.equal(Object.hasOwn(created.values, "createdAt"), false);
  assert.equal(Object.hasOwn(created.values, "createBy"), false);
  assert.equal(Object.hasOwn(created.values, "audit"), false);
  assert.equal(created.audit?.createBy?.id, admin.id);
  assert.equal(created.audit?.createBy?.login, admin.login);
  assert.deepEqual(Object.keys(created.audit!.createBy!).sort(), ["avatarUrl", "id", "login", "name"]);
  assert.equal(created.audit?.updatedAt, created.values.revision);
  const plainRead = await recordService.read(prisma, actor, created.values.id);
  assert.ok(plainRead.ok); assert.equal(plainRead.audit, undefined);
  const auditList = await service.list(prisma, actor, { ...state, query: admin.login, sort: "createByUser.login", filters: [{ field: "createdAt", operator: "gte", value: created.audit!.createdAt, precision: "instant" }] });
  assert.ok(auditList.ok, JSON.stringify(auditList)); assert.equal(auditList.data.total, 1);
  const author = auditList.data.rows[0].createByUser as { id: string; login: string; partner: unknown };
  assert.deepEqual(Object.keys(author).sort(), ["id", "login", "partner"]);
  assert.equal(author.id, admin.id);
  const plainList = await recordService.list(prisma, actor, state); assert.ok(plainList.ok);
  assert.ok(plainList.data.rows.every(row => !Object.hasOwn(row, "createByUser") && !Object.hasOwn(row, "createdAt")));
  const auditFiltered = await service.list(prisma, actor, { ...state, sort: "createByUser.partner.name", filters: [{ field: "createByUser.login", operator: "eq", value: admin.login }] });
  assert.ok(auditFiltered.ok, JSON.stringify(auditFiltered)); assert.equal(auditFiltered.data.total, 2);
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: created.values.id } })).createBy, admin.id);
  assert.ok(created.values.id); assert.ok(created.values.revision);
  const read = await service.read(prisma, actor, created.values.id);
  assert.ok(read.ok); assert.deepEqual(read.values, created.values);
  const changed = await service.save(prisma, actor, { ...created.values, quantity: 21 });
  assert.ok(changed.ok, JSON.stringify(changed));
  assert.ok(Date.parse(changed.values.revision!) > Date.parse(created.values.revision!));
  const stale = await service.save(prisma, actor, { ...created.values, name: "Obsoleto" });
  assert.equal(stale.ok, false); if (!stale.ok) assert.equal(stale.kind, "validation");
  const race = await Promise.all([service.save(prisma, actor, { ...changed.values, quantity: 30 }), service.save(prisma, actor, { ...changed.values, quantity: 31 })]);
  assert.equal(race.filter(result => result.ok).length, 1);
  assert.equal(race.filter(result => !result.ok && result.kind === "validation").length, 1);
  const forged = { id: reader.id, sessionVersion: reader.sessionVersion, isAdmin: true };
  for (const user of [forged, { ...actor, sessionVersion: actor.sessionVersion + 1 }]) {
    assert.equal((await service.read(prisma, user, created.values.id)).ok, false);
    assert.equal((await service.save(prisma, user, { ...defaults, name: "No autorizado" })).ok, false);
    assert.equal((await service.list(prisma, user, state)).ok, false);
  }
  const count = await prisma.ensayoFrameworkRecord.count();
  const duplicate = await service.save(prisma, actor, { ...defaults, name: "Registro de prueba" });
  assert.equal(duplicate.ok, false); if (!duplicate.ok) { assert.equal(duplicate.kind, "validation"); assert.match(duplicate.error, /únicos/); }
  for (const invalid of [
    { ...defaults, name: "" }, { ...defaults, name: "inválido", quantity: -1 },
    { ...defaults, name: "inválido", quantity: 2147483648 }, { ...defaults, name: "inválido", startsAt: "2026-11-07T14:00" },
    { ...defaults, name: "inválido", partnerId: "missing" }, { ...defaults, name: "inválido", id: created.values.id },
    { ...defaults, name: "inválido", isAdmin: true }, { ...defaults, name: "inválido", partner: { connect: { id: partner.id } } },
    { ...defaults, name: "Autor falsificado", createBy: reader.id },
    { ...created.values, audit: created.audit },
    { ...changed.values, createBy: reader.id },
    { ...defaults, name: "Relación falsificada", createByUser: { connect: { id: reader.id } } },
  ]) { const result = await service.save(prisma, actor, invalid); assert.equal(result.ok, false, JSON.stringify(result)); }
  assert.equal(await prisma.ensayoFrameworkRecord.count(), count);
  const business = await service.save(prisma, actor, { ...defaults, name: "bloqueado" });
  assert.equal(business.ok, false); if (!business.ok) { assert.equal(business.kind, "validation"); assert.equal(business.fieldErrors?.name, "Elige otro nombre."); }
  const rollback = await service.save(prisma, actor, { ...defaults, name: "rollback" });
  assert.equal(rollback.ok, false); assert.equal(await prisma.ensayoFrameworkRecord.count(), count);
  const normalized = await service.save(prisma, actor, { ...defaults, name: "normalizar" });
  assert.ok(normalized.ok); assert.equal(normalized.values.quantity, 7);
  const literal = await service.save(prisma, actor, { ...defaults, name: "100%_literal" }); assert.ok(literal.ok);
  const exact = await service.list(prisma, actor, { ...state, filters: [{ field: "name", operator: "eq", value: "100%_literal" }] });
  assert.ok(exact.ok); assert.equal(exact.data.total, 1);
  const search = await service.list(prisma, actor, { ...state, query: "%_" }); assert.ok(search.ok); assert.equal(search.data.total, 1);
  const numbers = await service.list(prisma, actor, { ...state, filters: [{ field: "quantity", operator: "gte", value: "12" }] });
  assert.ok(numbers.ok); assert.equal(numbers.data.total, 1);
  assert.equal((await service.list(prisma, actor, { ...state, filters: [{ field: "quantity", operator: "gt", value: "2147483648" }] })).ok, false);
  const dates = await service.list(prisma, actor, { ...state, filters: [{ field: "startsAt", operator: "between", value: "2026-11-07T00:00:00.000Z", to: "2026-11-08T00:00:00.000Z", precision: "instant" }] });
  assert.ok(dates.ok); assert.equal(dates.data.total, 1);
  const selected = await service.list(prisma, actor, { ...state, filters: [{ field: "status", operator: "eq", value: "draft" }] }); assert.ok(selected.ok);
  const page = await service.list(prisma, actor, { ...state, page: 999, pageSize: 1 }); assert.ok(page.ok); assert.equal(page.data.page, page.data.total);
  for (const filter of [{ field: "user.password", operator: "contains", value: "x" }, { field: "__proto__", operator: "eq", value: "x" }, { field: "quantity", operator: "contains", value: "2" }, { field: "status", operator: "contains", value: "dr" }]) assert.equal((await service.list(prisma, actor, { ...state, filters: [filter] })).ok, false);
  // Column pagination is server-side; moves reuse the form's permissions, validation, hooks and CAS.
  const draftColumn = await service.kanban(prisma, actor, { group: "draft", state: { ...state, pageSize: 1 } });
  assert.ok(draftColumn.ok); assert.equal(draftColumn.data.rows.length, 1); assert.equal(draftColumn.data.total, await prisma.ensayoFrameworkRecord.count({ where: { status: "draft" } }));
  assert.equal((await service.kanban(prisma, forged, { group: "draft", state })).ok, false);
  assert.equal((await service.kanban(prisma, actor, { group: "__proto__", state })).ok, false);
  const current = await service.read(prisma, actor, created.values.id); assert.ok(current.ok);
  const movement = { id: current.values.id!, revision: current.values.revision!, from: "draft", to: "done" };
  assert.equal((await service.move(prisma, forged, movement)).ok, false);
  assert.equal((await service.move(prisma, actor, { ...movement, to: "unknown" })).ok, false);
  assert.equal((await service.move(prisma, actor, { ...movement, isAdmin: true })).ok, false);
  const moveRace = await Promise.all([service.move(prisma, actor, movement), service.move(prisma, actor, movement)]);
  assert.equal(moveRace.filter(result => result.ok).length, 1);
  assert.equal(moveRace.filter(result => !result.ok && result.kind === "validation").length, 1);
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: movement.id } })).status, "done");
  assert.equal((await service.move(prisma, actor, movement)).ok, false);
  const doneColumn = await service.kanban(prisma, actor, { group: "done", state }); assert.ok(doneColumn.ok); assert.equal(doneColumn.data.total, 1);
  const excluded = await service.kanban(prisma, actor, { group: "done", state: { ...state, filters: [{ field: "status", operator: "eq", value: "draft" }] } }); assert.ok(excluded.ok); assert.equal(excluded.data.total, 0);
  for (const name of ["bloqueado", "rollback"]) {
    const row = await prisma.ensayoFrameworkRecord.create({ data: { name, active: true } });
    const denied = await service.move(prisma, actor, { id: row.id, revision: row.updatedAt.toISOString(), from: "draft", to: "done" });
    assert.equal(denied.ok, false); if (!denied.ok) assert.equal(denied.kind, "validation");
    assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: row.id } })).status, "draft");
  }
  // Authenticated creator is implicit, immutable across editors and absent from form payloads.
  const editor = await prisma.user.create({ data: { login: "fixture-editor", password: await hashPassword("framework-test-only"), isAdmin: true } });
  const editorActor = { id: editor.id, sessionVersion: editor.sessionVersion };
  const currentForAudit = await service.read(prisma, editorActor, created.values.id); assert.ok(currentForAudit.ok);
  const editedByAnother = await service.save(prisma, editorActor, { ...currentForAudit.values, notes: "Edición de otro administrador" });
  assert.ok(editedByAnother.ok, JSON.stringify(editedByAnother));
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: created.values.id } })).createBy, admin.id);
  const editorCreated = await service.save(prisma, editorActor, { ...defaults, name: "Creado por segundo administrador" });
  assert.ok(editorCreated.ok, JSON.stringify(editorCreated));
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: editorCreated.values.id } })).createBy, editor.id);
  // Existing records have an unknown author; editing one must not invent its creator.
  const legacy = await prisma.ensayoFrameworkRecord.create({ data: { name: "Legado sin autor", active: true, createBy: null } });
  const legacyForm = await service.read(prisma, actor, legacy.id); assert.ok(legacyForm.ok);
  const legacyEdit = await service.save(prisma, editorActor, { ...legacyForm.values, notes: "Conservar origen desconocido" }); assert.ok(legacyEdit.ok);
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: legacy.id } })).createBy, null);
  const legacyView = await service.read(prisma, actor, legacy.id); assert.ok(legacyView.ok); assert.equal(legacyView.audit?.createBy, null);
  const unknownAuthors = await service.list(prisma, actor, { ...state, filters: [{ field: "createByUser.login", operator: "empty" }] });
  assert.ok(unknownAuthors.ok, JSON.stringify(unknownAuthors)); assert.ok(unknownAuthors.data.rows.some(row => row.id === legacy.id));
  // List-action domains remain server-side and share count/pagination with visible filters.
  const mine = service.defineListAction({ domain: ({ actor }) => [{ field: "createBy", operator: "eq", value: actor.id }] });
  const ownCount = await prisma.ensayoFrameworkRecord.count({ where: { createBy: admin.id } });
  const ownPage = await mine(prisma, actor, { ...state, page: 999, pageSize: 1 });
  assert.ok(ownPage.ok, JSON.stringify(ownPage)); assert.equal(ownPage.data.total, ownCount); assert.equal(ownPage.data.page, ownCount);
  assert.equal(ownPage.data.rows.length, 1); assert.equal(ownPage.data.rows[0].createBy, admin.id);
  const ownAll = await mine(prisma, actor, { ...state, pageSize: 50 });
  assert.ok(ownAll.ok); assert.equal(ownAll.data.total, ownCount);
  assert.ok(ownAll.data.rows.every(row => row.createBy === admin.id));
  assert.ok(!ownAll.data.rows.some(row => [editorCreated.values.id, legacy.id].includes(row.id)));
  // SQL grouping uses the same authorized domain at every level, including nullable keys.
  const groupingState = { ...state, groupBy: ["active", "status", "notes"], pageSize: 1 };
  const groupRoot = await mine(prisma, actor, groupingState); assert.ok(groupRoot.ok, JSON.stringify(groupRoot));
  assert.equal(groupRoot.data.total, ownCount); assert.equal(groupRoot.data.rows.length, 0);
  const firstGroup = groupRoot.data.groups![0];
  const levelTwo = await mine(prisma, actor, { ...groupingState, groupPath: [firstGroup.value] }); assert.ok(levelTwo.ok, JSON.stringify(levelTwo));
  assert.equal(levelTwo.data.total, firstGroup.count);
  const secondGroup = levelTwo.data.groups![0];
  const levelThree = await mine(prisma, actor, { ...groupingState, groupPath: [firstGroup.value, secondGroup.value] }); assert.ok(levelThree.ok, JSON.stringify(levelThree));
  const thirdGroup = levelThree.data.groups![0];
  const leaf = await mine(prisma, actor, { ...groupingState, groupPath: [firstGroup.value, secondGroup.value, thirdGroup.value] }); assert.ok(leaf.ok, JSON.stringify(leaf));
  assert.equal(leaf.data.total, thirdGroup.count); assert.equal(leaf.data.groups, undefined);
  assert.ok(leaf.data.rows.every(row => row.createBy === admin.id && row.active === firstGroup.value && row.status === secondGroup.value && row.notes === thirdGroup.value));
  const noGroup = await mine(prisma, actor, { ...groupingState, filters: [{ field: "createByUser.login", operator: "eq", value: editor.login }] });
  assert.ok(noGroup.ok); assert.equal(noGroup.data.total, 0); assert.deepEqual(noGroup.data.groups, []);
  const oversizedGroupPage = await mine(prisma, actor, { ...groupingState, page: Number.MAX_SAFE_INTEGER });
  assert.ok(oversizedGroupPage.ok, JSON.stringify(oversizedGroupPage)); assert.ok(oversizedGroupPage.data.groups!.length > 0);
  assert.equal((await mine(prisma, reader, groupingState)).ok, false);
  assert.equal((await mine(prisma, { ...actor, sessionVersion: actor.sessionVersion + 1 }, groupingState)).ok, false);
  const contradict = await mine(prisma, actor, { ...state, filters: [{ field: "createByUser.login", operator: "eq", value: editor.login }] });
  assert.ok(contradict.ok); assert.equal(contradict.data.total, 0);
  const editorMine = await mine(prisma, editorActor, state); assert.ok(editorMine.ok); assert.equal(editorMine.data.total, 1); assert.equal(editorMine.data.rows[0].id, editorCreated.values.id);
  const hiddenAuthor = recordService.defineListAction({ domain: ({ actor }) => [{ field: "createBy", operator: "eq", value: actor.id }] });
  const hiddenPage = await hiddenAuthor(prisma, actor, state); assert.ok(hiddenPage.ok); assert.equal(hiddenPage.data.total, ownCount);
  assert.ok(hiddenPage.data.rows.every(row => !Object.hasOwn(row, "createBy") && !Object.hasOwn(row, "audit")));
  const inactive = await service.save(prisma, editorActor, { ...defaults, name: "Inactivo del ensayo", active: false }); assert.ok(inactive.ok);
  const activeAction = service.defineListAction({ domain: [{ field: "active", operator: "eq", value: true }] });
  const activePage = await activeAction(prisma, actor, { ...state, pageSize: 50 }); assert.ok(activePage.ok);
  assert.equal(activePage.data.total, await prisma.ensayoFrameworkRecord.count({ where: { active: true } }));
  assert.ok(!activePage.data.rows.some(row => row.id === inactive.values.id));
  const inactiveFilter = await activeAction(prisma, actor, { ...state, filters: [{ field: "active", operator: "eq", value: "false" }] });
  assert.ok(inactiveFilter.ok); assert.equal(inactiveFilter.data.total, 0);
  const grouped = service.defineListAction({ domain: [{ any: [
    { field: "id", operator: "eq", value: legacy.id },
    { all: [{ field: "createBy", operator: "eq", value: editor.id }, { not: { field: "active", operator: "eq", value: false } }] },
  ] }] });
  const groupedPage = await grouped(prisma, actor, state); assert.ok(groupedPage.ok); assert.equal(groupedPage.data.total, 2);
  const literalDomain = service.defineListAction({ domain: [{ field: "name", operator: "contains", value: "%_" }] });
  const literalPage = await literalDomain(prisma, actor, state); assert.ok(literalPage.ok); assert.equal(literalPage.data.total, 1);
  const unknownCreator = service.defineListAction({ domain: [{ field: "createBy", operator: "eq", value: null }] });
  const unknownPage = await unknownCreator(prisma, actor, state); assert.ok(unknownPage.ok);
  assert.equal(unknownPage.data.total, await prisma.ensayoFrameworkRecord.count({ where: { createBy: null } }));
  for (const domain of [[{ any: [] }], [{ not: { all: [] } }], [{ field: "id", operator: "in", value: [] }]]) {
    const none = service.defineListAction({ domain } as Parameters<typeof service.defineListAction>[0]);
    const page = await none(prisma, actor, state); assert.ok(page.ok); assert.equal(page.data.total, 0);
  }
  assert.equal((await mine(prisma, reader, state)).ok, false);
  assert.equal((await mine(prisma, { ...actor, sessionVersion: actor.sessionVersion + 1 }, state)).ok, false);
  assert.equal((await mine(prisma, actor, { ...state, domain: [] })).ok, false);
  // A list domain does not replace record-access authorization for read/save.
  assert.equal((await service.read(prisma, actor, editorCreated.values.id)).ok, true);
  // A foreign-key backed author cannot point to an unknown account.
  await assert.rejects(prisma.ensayoFrameworkRecord.create({ data: { name: "Autor inexistente", active: true, createBy: "missing-user" } }));
  const unbound = createModelService(recordModel, unboundRepository<ReturnType<typeof recordModel.parse>>(), { columns: [{ field: "name", label: "Nombre" }], searchFields: ["name"] });
  const notReady = await unbound.save(prisma, actor, { ...defaults, name: "Pendiente" }); assert.equal(notReady.ok, false); if (!notReady.ok) assert.match(notReady.error, /orm:bind/);
  await prisma.user.update({ where: { id: admin.id }, data: { active: false } });
  assert.equal((await service.list(prisma, actor, state)).ok, false);
  await prisma.user.update({ where: { id: admin.id }, data: { active: true } });
  // Deletion is transactional: permissions, complete selection, revisions and FK restrictions.
  const deleteA = await service.save(prisma, actor, { ...defaults, name: "Eliminar A" }); assert.ok(deleteA.ok);
  const deleteB = await service.save(prisma, actor, { ...defaults, name: "Eliminar B" }); assert.ok(deleteB.ok);
  const targets = [deleteA.values, deleteB.values].map(row => ({ id: row.id!, revision: row.revision! }));
  const newerB = await service.save(prisma, actor, { ...deleteB.values, notes: "Nueva revisión" }); assert.ok(newerB.ok);
  const staleDelete = await service.remove(prisma, actor, targets); assert.equal(staleDelete.ok, false);
  assert.equal(await prisma.ensayoFrameworkRecord.count({ where: { id: { in: targets.map(row => row.id) } } }), 2);
  assert.equal((await service.remove(prisma, reader, targets)).ok, false);
  assert.equal((await service.remove(prisma, { ...actor, sessionVersion: actor.sessionVersion + 1 }, targets)).ok, false);
  assert.equal((await service.remove(prisma, actor, [targets[0], targets[0]])).ok, false);
  const deleted = await service.remove(prisma, actor, [targets[0], { id: newerB.values.id, revision: newerB.values.revision }]);
  assert.deepEqual(deleted, { ok: true, deleted: 2 });
  assert.equal(await prisma.ensayoFrameworkRecord.count({ where: { id: { in: targets.map(row => row.id) } } }), 0);
  const raceRecord = await service.save(prisma, actor, { ...defaults, name: "Eliminar concurrente" }); assert.ok(raceRecord.ok);
  const raceTarget = [{ id: raceRecord.values.id, revision: raceRecord.values.revision }];
  const deleteRace = await Promise.all([service.remove(prisma, actor, raceTarget), service.remove(prisma, actor, raceTarget)]);
  assert.equal(deleteRace.filter(result => result.ok).length, 1);
  const freePartner = await prisma.partner.create({ data: { name: "Contacto eliminable" } });
  const linkedPartner = await prisma.partner.findUniqueOrThrow({ where: { id: partner.id } });
  const contactBatch = [{ id: freePartner.id, revision: freePartner.updatedAt.toISOString() }, { id: linkedPartner.id, revision: linkedPartner.updatedAt.toISOString() }];
  assert.equal((await deleteRegisteredRecords(prisma, actor, "partner", contactBatch)).ok, false);
  assert.equal(await prisma.partner.count({ where: { id: freePartner.id } }), 1); // rollback after first deletion
  assert.deepEqual(await deleteRegisteredRecords(prisma, actor, "partner", [contactBatch[0]]), { ok: true, deleted: 1 });
  const keptContact = await prisma.partner.create({ data: { name: "Contacto compartido conservado" } });
  const disposableUser = await prisma.user.create({ data: { login: "fixture-delete", password: await hashPassword("framework-test-only"), partnerId: keptContact.id } });
  const userTarget = { id: disposableUser.id, revision: disposableUser.updatedAt.toISOString() };
  const currentAdmin = await prisma.user.findUniqueOrThrow({ where: { id: actor.id } });
  assert.equal((await deleteRegisteredRecords(prisma, actor, "user", [userTarget, { id: actor.id, revision: currentAdmin.updatedAt.toISOString() }])).ok, false);
  assert.equal(await prisma.user.count({ where: { id: disposableUser.id } }), 1);
  assert.equal((await deleteRegisteredRecords(prisma, actor, "user", [userTarget, { id: editor.id, revision: editor.updatedAt.toISOString() }])).ok, false);
  assert.equal(await prisma.user.count({ where: { id: disposableUser.id } }), 1); // audit FK rejects entire batch
  assert.deepEqual(await deleteRegisteredRecords(prisma, actor, "user", [userTarget]), { ok: true, deleted: 1 });
  assert.equal(await prisma.partner.count({ where: { id: keptContact.id } }), 1);
  // Default model activity: persisted snapshots, permissions, notes, pagination and rollback.
  const tracked = await service.save(prisma, actor, { ...defaults, name: "Actividad inicial", notes: "VALOR PRIVADO NO AUDITAR" });
  assert.ok(tracked.ok, JSON.stringify(tracked));
  const activityWhere = { model: recordModel.name, recordId: tracked.values.id! };
  const history = await service.activity(prisma, actor, { id: tracked.values.id });
  assert.ok(history.ok); assert.equal(history.data.entries.length, 1); assert.equal(history.data.entries[0].kind, "create");
  assert.equal(history.data.entries[0].author.id, actor.id);
  assert.deepEqual(history.data.entries[0].changes, []);
  assert.deepEqual((await prisma.recordActivity.findFirstOrThrow({ where: activityWhere })).changes, []);
  assert.ok(!JSON.stringify(history).includes("VALOR PRIVADO NO AUDITAR"));
  const unchanged = await service.save(prisma, actor, tracked.values); assert.ok(unchanged.ok);
  assert.equal(await prisma.recordActivity.count({ where: activityWhere }), 1);
  const edited = await service.save(prisma, editorActor, { ...unchanged.values, name: "Actividad editada", active: false }); assert.ok(edited.ok);
  const changedHistory = await service.activity(prisma, actor, { id: tracked.values.id }); assert.ok(changedHistory.ok);
  assert.equal(changedHistory.data.entries[0].author.id, editor.id);
  assert.ok(changedHistory.data.entries[0].changes.some(change => change.field === "active" && change.before === true && change.after === false));
  const normalizedCurrent = await service.read(prisma, actor, normalized.values.id); assert.ok(normalizedCurrent.ok);
  const intermediate = await service.save(prisma, actor, { ...normalizedCurrent.values, name: "Temporal para hooks", quantity: 3 }); assert.ok(intermediate.ok);
  const normalizedEdit = await service.save(prisma, actor, { ...intermediate.values, name: "normalizar", quantity: 1 }); assert.ok(normalizedEdit.ok);
  const normalizedHistory = await service.activity(prisma, actor, { id: normalized.values.id }); assert.ok(normalizedHistory.ok);
  assert.equal(normalizedHistory.data.entries[0].kind, "update");
  assert.ok(normalizedHistory.data.entries[0].changes.some(change => change.field === "quantity" && change.after === 7));
  const note = { id: tracked.values.id, body: "Nota de prueba <script>texto literal</script>", requestId: randomUUID() };
  const revisionBeforeNote = (await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: tracked.values.id } })).updatedAt.toISOString();
  assert.equal((await service.addNote(prisma, actor, note)).ok, true);
  assert.equal((await service.addNote(prisma, actor, note)).ok, true);
  assert.equal(await prisma.recordActivity.count({ where: { ...activityWhere, requestId: note.requestId } }), 1);
  const concurrentNote = { ...note, body: "Reintento simultáneo", requestId: randomUUID() };
  const concurrentNotes = await Promise.all([service.addNote(prisma, actor, concurrentNote), service.addNote(prisma, actor, concurrentNote)]);
  assert.ok(concurrentNotes.some(result => result.ok));
  assert.equal((await service.addNote(prisma, actor, concurrentNote)).ok, true);
  assert.equal(await prisma.recordActivity.count({ where: { ...activityWhere, requestId: concurrentNote.requestId } }), 1);
  assert.equal((await service.addNote(prisma, actor, { ...note, body: "Contenido distinto" })).ok, false);
  assert.equal((await prisma.ensayoFrameworkRecord.findUniqueOrThrow({ where: { id: tracked.values.id } })).updatedAt.toISOString(), revisionBeforeNote);
  for (const account of [reader, { ...actor, sessionVersion: actor.sessionVersion + 1 }]) {
    assert.equal((await service.activity(prisma, account, { id: tracked.values.id })).ok, false);
    assert.equal((await service.addNote(prisma, account, { ...note, requestId: randomUUID() })).ok, false);
  }
  for (const patch of [{ actorId: editor.id }, { model: "OtherModel" }, { changes: [] }, { body: " " }, { body: "x".repeat(4001) }]) assert.equal((await service.addNote(prisma, actor, { ...note, ...patch })).ok, false);
  assert.equal((await service.activity(prisma, actor, { id: "missing" })).ok, false);
  assert.equal((await service.addNote(prisma, actor, { ...note, id: "missing", requestId: randomUUID() })).ok, false);
  await prisma.recordActivity.create({ data: { model: "OtherModel", recordId: tracked.values.id!, actorId: actor.id, kind: "note", body: "NO CRUZAR MODELOS" } });
  for (let index = 0; index < 22; index++) assert.equal((await service.addNote(prisma, actor, { ...note, body: `Nota ${index}`, requestId: randomUUID() })).ok, true);
  const seen = new Set<string>();
  let cursor: { id: string; createdAt: string } | undefined;
  do {
    const page = await service.activity(prisma, actor, { id: tracked.values.id, cursor }); assert.ok(page.ok);
    for (const entry of page.data.entries) { assert.ok(!seen.has(entry.id)); seen.add(entry.id); assert.notEqual(entry.body, "NO CRUZAR MODELOS"); }
    cursor = page.data.nextCursor ?? undefined;
  } while (cursor);
  assert.equal(seen.size, await prisma.recordActivity.count({ where: activityWhere }));
  const privateService = createModelService({ ...recordModel, metadata: { ...recordModel.metadata, name: { ...recordModel.metadata.name, tracking: false } } }, EnsayoFrameworkRecordRepository, { columns: [{ field: "name", label: "Nombre", sortable: true }], searchFields: ["name"] });
  const privateHistory = await privateService.activity(prisma, actor, { id: normalized.values.id }); assert.ok(privateHistory.ok);
  assert.ok(privateHistory.data.entries.every(entry => entry.changes.every(change => change.field !== "name")));
  assert.ok(privateHistory.data.entries.some(entry => entry.changes.some(change => change.field === "quantity" && change.after === 7)));
  assert.ok(!JSON.stringify(privateHistory).includes("normalizar"));
  const rolledBackService = createModelService(recordModel, { ...EnsayoFrameworkRecordRepository, audit: async () => { throw new Error("Audit read failure after write"); } }, { columns: [{ field: "name", label: "Nombre" }], searchFields: [], audit: true });
  const activityCount = await prisma.recordActivity.count();
  assert.equal((await rolledBackService.save(prisma, actor, { ...defaults, name: "Rollback de actividad" })).ok, false);
  assert.equal(await prisma.recordActivity.count(), activityCount);
  assert.equal(await prisma.ensayoFrameworkRecord.count({ where: { name: "Rollback de actividad" } }), 0);
  const revision = edited.values.revision;
  const racing = await Promise.all([service.save(prisma, actor, { ...edited.values, name: "Actividad carrera A" }), service.save(prisma, editorActor, { ...edited.values, name: "Actividad carrera B" })]);
  assert.equal(racing.filter(result => result.ok).length, 1);
  assert.equal(await prisma.recordActivity.count({ where: { ...activityWhere, kind: "update" } }), 2);
  assert.equal((await service.save(prisma, actor, { ...edited.values, revision, name: "Cambio obsoleto" })).ok, false);
  const latest = await service.read(prisma, actor, tracked.values.id); assert.ok(latest.ok);
  assert.equal((await service.move(prisma, actor, { id: tracked.values.id, revision: latest.values.revision, from: "draft", to: "done" })).ok, true);
  const movedHistory = await service.activity(prisma, actor, { id: tracked.values.id }); assert.ok(movedHistory.ok);
  assert.ok(movedHistory.data.entries[0].changes.some(change => change.field === "status" && change.beforeLabel === "Borrador" && change.afterLabel === "Terminado"));
  const toRemove = await service.read(prisma, actor, tracked.values.id); assert.ok(toRemove.ok);
  assert.equal((await service.remove(prisma, actor, [{ id: tracked.values.id, revision: toRemove.values.revision! }])).ok, true);
  assert.equal((await service.activity(prisma, actor, { id: tracked.values.id })).ok, false);
  assert.equal((await service.addNote(prisma, actor, { ...note, requestId: randomUUID() })).ok, false);
  // Declarative reactions and decorators share the service's actor/revision policy.
  const {Fields,defineModel,onchange,depends,constraint,ModelValidationError}=await import("./src/lib/orm");
  const {EnsayoFrameworkRecord}=await import("./src/app/(auth)/erp/ensayo-framework/models/Record");
  class ReactionExample extends EnsayoFrameworkRecord {
    doubleQuantity=Fields.Integer({compute:"computeDouble",required:true});
    @depends("quantity")
    computeDouble(values:ReactionValues){return Number(values.quantity??0)*2;}
    preview={login:Fields.Text()};
    @onchange({fields:["name"],writes:["name"]})
    async changeName(values:ReactionValues,{tx,actor}:ReactionContext){
      if(values.name==="try-write")await tx.user.update({where:{id:actor.id},data:{active:false}});
      return {name:typeof values.name==="string"?values.name.toUpperCase():null};
    }
    @depends({fields:["name"],preview:["login"]})
    async previewLogin(_values:ReactionValues,{tx,actor}:ReactionContext){return {login:(await tx.user.findUniqueOrThrow({where:{id:actor.id},select:{login:true}})).login};}
    @constraint("name")
    rejectName(values:ReactionValues,_context:ModelContext){if(values.name==="reject-constraint")throw new ModelValidationError("Restricción declarativa.",{name:"Cambia el nombre."});}
  }
  const reactionModel=defineModel(ReactionExample,{name:recordModel.name,table:recordModel.table});
  const reactionService=createModelService(reactionModel,EnsayoFrameworkRecordRepository,{columns:[{field:"name",label:"Nombre"}],searchFields:["name"]});
  const reactionUser=await prisma.user.create({data:{login:"fixture-reaction",password:await hashPassword("framework-test-only"),isAdmin:true}});
  const reactionActor={id:reactionUser.id,sessionVersion:reactionUser.sessionVersion};
  const countBeforeReaction=await prisma.ensayoFrameworkRecord.count();
  const activitiesBeforeReaction=await prisma.recordActivity.count();
  const reacted=await reactionService.react(prisma,reactionActor,{field:"name",values:{name:"reaction"}});
  assert.deepEqual(reacted,{ok:true,patch:{name:"REACTION"},preview:{login:"fixture-reaction"}});
  assert.deepEqual(await reactionService.react(prisma,reactionActor,{field:"quantity",values:{quantity:3}}),{ok:true,patch:{},preview:{doubleQuantity:6}});
  assert.equal(reactionModel.schema.safeParse({...defaults,doubleQuantity:999}).success,false);
  assert.equal((await reactionService.react(prisma,reactionActor,{field:"name",values:{name:"try-write"}})).ok,false);
  assert.equal((await prisma.user.findUniqueOrThrow({where:{id:reactionActor.id}})).active,true);
  assert.equal(await prisma.ensayoFrameworkRecord.count(),countBeforeReaction);
  assert.equal(await prisma.recordActivity.count(),activitiesBeforeReaction);
  for(const bad of [{field:"deleteRecords",values:{}},{field:"name",values:{name:"x",notes:"secret"}},{field:"name",values:{name:"x",createBy:"fake"}}])assert.equal((await reactionService.react(prisma,reactionActor,bad)).ok,false);
  assert.equal((await reactionService.react(prisma,{...reactionActor,sessionVersion:999},{field:"name",values:{name:"x"}})).ok,false);
  assert.equal((await reactionService.react(prisma,{id:reader.id,sessionVersion:reader.sessionVersion},{field:"name",values:{name:"x"}})).ok,false);
  const rejected=await reactionService.save(prisma,reactionActor,{...defaults,name:"reject-constraint"});
  assert.equal(rejected.ok,false);
  assert.equal(await prisma.ensayoFrameworkRecord.count({where:{name:"reject-constraint"}}),0);
  console.log("✓ Reacciones readonly, actor aislado, patches, restricciones y ausencia de persistencia/actividad verificados.");
  // Real generated related projection, exclusively in this disposable PostgreSQL schema.
  const {vehicleModel:relatedVehicleModel,variantModel:relatedVariantModel}=await import("./src/app/(auth)/erp/related-check/orm.config");
  const {RelatedTestVehicleRepository}=await import("./src/generated/orm/bindings/related-check/RelatedTestVehicle.store");
  const manufacturer=await prisma.relatedTestMaker.create({data:{name:"Related fixture",avatar:"https://example.com/fixture.png"}});
  const variant=await prisma.relatedTestVariant.create({data:{name:"Related model",fabricanteId:manufacturer.id,vehicleType:"car"}});
  let relatedQueries=0;
  const relatedService=createModelService(relatedVehicleModel,{...RelatedTestVehicleRepository,related:async(tx,field,id)=>{relatedQueries++;return RelatedTestVehicleRepository.related!(tx,field,id);}}, {list:{fields:["name","plate","active"],searchFields:["plate"],sortable:[],filterable:[],groupable:[]}});
  const relatedActivities=await prisma.recordActivity.count();
  const relatedVehicles=await prisma.relatedTestVehicle.count();
  assert.deepEqual(await relatedService.react(prisma,reactionActor,{field:"name",values:{name:variant.id}}),{ok:true,patch:{},preview:{fabricanteAvatar:"https://example.com/fixture.png",fabricanteNombre:"Related fixture"}});
  assert.equal(relatedQueries,1);
  assert.equal((await relatedService.react(prisma,{id:reader.id,sessionVersion:reader.sessionVersion},{field:"name",values:{name:variant.id}})).ok,false);
  assert.equal(relatedQueries,1);
  await prisma.relatedTestMaker.update({where:{id:manufacturer.id},data:{avatar:null}});
  const refreshedRelated=await relatedService.react(prisma,reactionActor,{field:"name",values:{name:variant.id}});
  assert.ok(refreshedRelated.ok);assert.equal(refreshedRelated.preview.fabricanteAvatar,null);
  assert.equal((await relatedService.react(prisma,reactionActor,{field:"name",values:{name:"missing-related"}})).ok,false);
  assert.equal(await prisma.relatedTestVehicle.count(),relatedVehicles);
  assert.equal(await prisma.recordActivity.count(),relatedActivities);
  console.log("✓ Related generado: dos salidas en una lectura, permisos, null/ausencia y sin escrituras en vehículos/actividad.");
  // Page/branch projection uses the generated batched delegate, in the same list transaction.
  await prisma.relatedTestMaker.update({where:{id:manufacturer.id},data:{avatar:"https://example.com/fixture.png"}});
  const twinVariant=await prisma.relatedTestVariant.create({data:{name:"Related model",fabricanteId:manufacturer.id,vehicleType:"car"}});
  await prisma.relatedTestVehicle.createMany({data:[{name:variant.id,plate:"RELATED-1"},{name:variant.id,plate:"RELATED-2"},{name:twinVariant.id,plate:"RELATED-3"}]});
  let relatedBatches=0, displayBatches=0;
  const {RelatedTestVariantRepository}=await import("./src/generated/orm/bindings/related-check/RelatedTestVariant.store");
  const modeloLookup=createModelService(relatedVariantModel,RelatedTestVariantRepository,{list:{fields:["name","fabricanteId","vehicleType"],searchFields:["name"],sortable:["name"],filterable:[],groupable:[]}});
  const collectionService=createModelService(relatedVehicleModel,{...RelatedTestVehicleRepository,lookup:async(tx,query)=>{displayBatches++;return RelatedTestVehicleRepository.lookup!(tx,query);},relatedMany:async(tx,field,ids,outputs)=>{relatedBatches++;return RelatedTestVehicleRepository.relatedMany!(tx,field,ids,outputs);}}, {list:{fields:["name","plate","active","fabricanteAvatar"],searchFields:["plate"],sortable:["plate"],filterable:["plate"],groupable:["name"]},relations:{name:request=>modeloLookup.lookup(prisma,reactionActor,request)}});
  const relatedState={query:"",page:1,pageSize:10,sort:"plate",direction:"asc" as const,filters:[]};
  const relatedList=await collectionService.list(prisma,reactionActor,relatedState);assert.ok(relatedList.ok);
  assert.equal(relatedList.data.rows.length,3);assert.equal(relatedBatches,1);
  assert.equal(displayBatches,1);assert.ok(relatedList.data.rows.every(row=>row.$displayName==="Related model"));
  assert.ok(relatedList.data.rows.every(row=>row.fabricanteAvatar==="https://example.com/fixture.png"));
  assert.ok(relatedList.data.rows.every(row=>row.fabricanteNombre===undefined));
  const relatedGroups=await collectionService.list(prisma,reactionActor,{...relatedState,groupBy:["name"]});assert.ok(relatedGroups.ok);
  assert.equal(relatedGroups.data.groups?.length,2);assert.equal(relatedBatches,1);
  assert.equal(displayBatches,1);
  assert.equal(relatedGroups.data.groups?.[0].label,relatedGroups.data.groups?.[1].label);
  assert.notEqual(relatedGroups.data.groups?.[0].value,relatedGroups.data.groups?.[1].value);
  const relatedLeaf=await collectionService.list(prisma,reactionActor,{...relatedState,groupBy:["name"],groupPath:[variant.id]});assert.ok(relatedLeaf.ok);
  assert.equal(relatedLeaf.data.rows.length,2);assert.equal(relatedBatches,2);
  assert.equal(displayBatches,2);assert.ok(relatedLeaf.data.rows.every(row=>row.$displayName==="Related model"));
  assert.ok(relatedLeaf.data.rows.every(row=>row.name===variant.id&&row.fabricanteAvatar));
  console.log("✓ Related por lote en página/rama y agrupación Many2one SQL con etiquetas iguales e identidades distintas verificados.");
  const formVehicle=await prisma.relatedTestVehicle.findFirstOrThrow({where:{plate:"RELATED-1"}});
  const formOpened=await collectionService.read(prisma,reactionActor,formVehicle.id);
  assert.ok(formOpened.ok);assert.equal(formOpened.displayName,"Related model");
  assert.equal(Object.hasOwn(formOpened.values,"displayName"),false);
  const newVariant=await prisma.relatedTestVariant.create({data:{name:"Changed model",fabricanteId:manufacturer.id,vehicleType:"car"}});
  const formSaved=await collectionService.save(prisma,reactionActor,{...formOpened.values,name:newVariant.id});
  assert.ok(formSaved.ok);assert.equal(formSaved.displayName,"Changed model");
  const formReopened=await collectionService.read(prisma,reactionActor,formVehicle.id);
  assert.ok(formReopened.ok);assert.equal(formReopened.displayName,"Changed model");
  assert.equal((await collectionService.save(prisma,reactionActor,{...formSaved.values,displayName:"Forged"})).ok,false);
  console.log("✓ Nombre de formulario desde relación: abrir, guardar, reabrir y rechazo de metadata falsificada verificados.");
} finally { await prisma.$disconnect(); }
