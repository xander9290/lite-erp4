import assert from "node:assert/strict";
import { access, readFile } from "node:fs/promises";
import { syncApplication } from "./src/lib/orm/generator/sync";

let approvals = 0;
const messages: string[] = [];
const mode = process.argv[2];
const run = () => syncApplication(process.cwd(), "facil", {
  log: message => messages.push(message),
  confirm: async () => {
    approvals++;
    assert.ok(messages.some(message => message.includes('CREATE TABLE "facil_') || message.includes('ADD COLUMN')));
    return mode !== "cancel";
  },
});
if (mode === "cancel") {
  await assert.rejects(run(), /Cancelado/);
  assert.equal(approvals, 1);
  assert.ok(!messages.some(message => message.includes("Generar Prisma Client")));
} else if (mode === "type-error") {
  await assert.rejects(run(), /Detenido en «Comprobar TypeScript»/);
  assert.equal(approvals, 0);
  assert.ok(!messages.some(message => message.includes("✓ facil sincronizada")));
} else {
  await run();
  assert.equal(approvals, mode === "repeat" ? 0 : 1);
  const source = await readFile("src/generated/orm/bindings/facil/FacilRecord.store.ts", "utf8");
  assert.match(source, /tx.facilRecord.create/);
  assert.ok(messages.some(message => message.includes("✓ facil sincronizada")));
}
await assert.rejects(access("prisma/.orm-sync.lock"));
