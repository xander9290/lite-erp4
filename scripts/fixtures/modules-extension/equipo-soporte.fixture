import "server-only";
import { Fields, ModelValidationError, action, depends, type ReactionValues } from "@/lib/orm";
import { extendModel } from "@/lib/modules/extend";
import { Equipo } from "@/modules/taller/models/equipo";

/**
 * Soporte extends taller.equipo without editing it. Legacy decorators need a class
 * declaration, so the class is declared inside the mixin and returned.
 */
export const EquipoSoporte = extendModel(Equipo, Base => {
  class EquipoSoporte extends Base {
    responsable = Fields.Text({ label: "Responsable", maxLength: 60, tracking: true, searchable: true, groupable: true });
    nivel = Fields.Integer({ label: "Nivel de soporte", required: true, default: 1, min: 1, max: 3, tracking: true, groupable: true });
    etiqueta = Fields.Text({ label: "Etiqueta", compute: "calcularEtiqueta" });
    logo = Fields.Image({ label: "Logo", folder: "extension-fixture", tracking: true });
    codigo = Fields.Text({ label: "Código único", unique: true, maxLength: 40 });
    equipoId = Fields.Many2one("TallerEquipo", { label: "Equipo relacionado" });
    nombreEquipo = Fields.Text({ label: "Nombre del equipo", related: "equipoId.name" });
    responsableEquipo = Fields.Text({ label: "Responsable del equipo", related: "equipoId.responsable" });
    imagenEquipo = Fields.Image({ label: "Logo del equipo", related: "equipoId.logo" });
    // Many2many of an extension: links reference the companion row (owned by soporte).
    marcas = Fields.Many2many("SoporteMarca", { label: "Marcas", maxSelected: 3 });

    @depends("nivel")
    calcularEtiqueta(values: ReactionValues) { return `Nivel ${values.nivel}`; }

    @action({ label: "Escalar" })
    escalar(record: { nivel: number }) { return { nivel: Math.min(3, record.nivel + 1) }; }

    beforeSave(values: Record<string, unknown>) {
      const result = super.beforeSave(values); // keeps the base rule (uppercase name)
      if (result.estado === "baja" && !result.responsable) throw new ModelValidationError("Asigna un responsable.", { responsable: "Requerido para dar de baja." });
      return result;
    }
  }
  return EquipoSoporte;
});
