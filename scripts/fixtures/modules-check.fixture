import assert from "node:assert/strict";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { getModuleModel, modelClientConfig, modelService, withActor } = await import("./src/lib/modules/registry");
const { hashPassword } = await import("./src/lib/auth/password");
const { fieldFromMetadata } = await import("./src/lib/modules/fields");

// Runs only inside the disposable project/schema created by modules.integration.ts.
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };
const password = await hashPassword("modules-test-only");
const admin = await prisma.user.create({ data: { login: "modules-admin", password, isAdmin: true, partner: { create: { name: "Administrador de prueba" } } } });
const reader = await prisma.user.create({ data: { login: "modules-reader", password, isAdmin: false } });
const actor = { id: admin.id, sessionVersion: admin.sessionVersion };
const readerActor = { id: reader.id, sessionVersion: reader.sessionVersion };
const categorias = modelService("ensayo.categoria");
const tareas = modelService("ensayo.tarea");
const ok = <T extends { ok: boolean }>(result: T, label: string) => { assert.equal(result.ok, true, `${label}: ${JSON.stringify(result)}`); return result as Extract<T, { ok: true }>; };

// Registry: only registered ids, serializable client contract.
for (const invalid of ["ensayo.nope", "otro.tarea", "../ensayo.tarea", 42, null]) assert.equal(getModuleModel(invalid), undefined, String(invalid));
const clientConfig = modelClientConfig("ensayo.tarea");
// structuredClone rejects functions and class instances: only plain data may reach the browser.
assert.doesNotThrow(() => structuredClone(clientConfig));
assert.deepEqual(clientConfig.lookups, { categoria: "ensayo.categoria" });
const plain = (value: unknown) => JSON.parse(JSON.stringify(value));
for (const [name, metadata] of Object.entries(clientConfig.fields)) assert.deepEqual(plain(fieldFromMetadata(metadata).metadata), plain(metadata), name);

// Create through the runtime repository: createBy, revision and display name.
const hogar = ok(await categorias.save(prisma, actor, { name: "Hogar", active: true }), "crear categoría");
const trabajo = ok(await categorias.save(prisma, actor, { name: "Trabajo", active: true }), "crear categoría 2");
assert.equal(hogar.displayName, "Hogar");
assert.equal(hogar.audit?.createBy?.login, "modules-admin");
assert.equal((await prisma.ensayoCategoria.findUniqueOrThrow({ where: { id: hogar.values.id } })).createBy, admin.id);
const base = { categoria: hogar.values.id, estado: "pendiente", prioridad: 3, vence: null };
const t1 = ok(await tareas.save(prisma, actor, { ...base, name: "  Lavar   ropa " }), "crear tarea");
assert.equal(t1.values.name, "Lavar ropa", "normalize del modelo");
ok(await tareas.save(prisma, actor, { ...base, name: "Pagar luz", categoria: trabajo.values.id, prioridad: 5, vence: "2026-12-01T15:00:00.000Z" }), "crear tarea 2");
ok(await tareas.save(prisma, actor, { ...base, name: "Comprar pan" }), "crear tarea 3");

// Business rule from beforeSave returns field errors without writing.
const rejected = await tareas.save(prisma, actor, { ...base, name: "Urgente", estado: "hecha", prioridad: 5 });
assert.equal(rejected.ok, false);
assert.equal(!rejected.ok && rejected.fieldErrors?.prioridad, "Una tarea urgente no puede cerrarse sin revisión.");
assert.equal(await prisma.ensayoTarea.count({ where: { name: "Urgente" } }), 0);
assert.equal((await tareas.save(prisma, actor, { ...base, name: "Campo extra", hacker: true })).ok, false, "rechaza campos no declarados");

// Read and concurrency.
const read = ok(await tareas.read(prisma, actor, t1.values.id), "leer");
assert.equal(read.values.vence, null);
const edited = ok(await tareas.save(prisma, actor, { ...read.values, prioridad: 4 }), "editar");
assert.notEqual(edited.values.revision, read.values.revision);
assert.equal((await tareas.save(prisma, actor, { ...read.values, prioridad: 2 })).ok, false, "revisión vieja rechazada");

// Lists: search, filter, order, grouping by Many2one with authorized labels (actor reused by withActor).
const list = ok(await withActor(actor, () => tareas.list(prisma, actor, state)), "lista");
assert.equal(list.data.total, 3);
assert.deepEqual(list.data.rows.map(row => row.name), ["Comprar pan", "Lavar ropa", "Pagar luz"]);
assert.equal((list.data.rows[2] as { $labels?: Record<string, { label: string }> }).$labels?.categoria.label, "Trabajo");
assert.equal(list.data.rows[2].vence, "2026-12-01T15:00:00.000Z");
const search = ok(await withActor(actor, () => tareas.list(prisma, actor, { ...state, query: "pan" })), "búsqueda");
assert.deepEqual(search.data.rows.map(row => row.name), ["Comprar pan"]);
const filtered = ok(await withActor(actor, () => tareas.list(prisma, actor, { ...state, filters: [{ field: "prioridad", operator: "gte", value: "4" }] })), "filtro");
assert.deepEqual(filtered.data.rows.map(row => row.name), ["Lavar ropa", "Pagar luz"]);
const grouped = ok(await withActor(actor, () => tareas.list(prisma, actor, { ...state, groupBy: ["categoria"] })), "agrupación");
assert.deepEqual(grouped.data.groups?.map(group => [group.label, group.count]).sort(), [["Hogar", 2], ["Trabajo", 1]]);
const outside = await tareas.list(prisma, actor, state);
assert.equal(outside.ok, false, "las etiquetas fallan cerrado sin actor de la operación");

// Lookup, kanban, move, activity and notes.
const lookup = ok(await categorias.lookup(prisma, actor, { query: "hog" }), "lookup");
assert.deepEqual(lookup.items.map(item => item.label), ["Hogar"]);
const column = ok(await withActor(actor, () => tareas.kanban(prisma, actor, { group: "pendiente", state })), "kanban");
assert.equal(column.data.total, 3);
const current = ok(await tareas.read(prisma, actor, t1.values.id), "leer para mover");
ok(await tareas.move(prisma, actor, { id: t1.values.id, revision: current.values.revision, from: "pendiente", to: "curso" }), "mover");
assert.equal((await tareas.move(prisma, actor, { id: t1.values.id, revision: current.values.revision, from: "pendiente", to: "hecha" })).ok, false, "mover con revisión vieja");
const activity = ok(await tareas.activity(prisma, actor, { id: t1.values.id }), "actividad");
assert.ok(activity.data.entries.some(entry => entry.kind === "update" && entry.changes.some(change => change.field === "estado" && change.after === "curso")), JSON.stringify(activity.data.entries));
assert.ok(activity.data.entries.some(entry => entry.kind === "create"));
ok(await tareas.addNote(prisma, actor, { id: t1.values.id, body: "Nota de prueba", requestId: "00000000-0000-4000-8000-000000000001" }), "nota");

// Deletion: FK protection, revision check, then success.
const categoriaRead = ok(await categorias.read(prisma, actor, hogar.values.id), "leer categoría");
const blocked = await categorias.remove(prisma, actor, [{ id: hogar.values.id, revision: categoriaRead.values.revision }]);
assert.equal(blocked.ok, false, "Restrict impide borrar una categoría usada");
const all = ok(await withActor(actor, () => tareas.list(prisma, actor, { ...state, pageSize: 50 })), "lista para borrar");
const selection = all.data.rows.map(row => ({ id: row.id, revision: row.revision! }));
assert.equal((await tareas.remove(prisma, actor, selection.map((item, index) => index ? item : { ...item, revision: "2000-01-01T00:00:00.000Z" }))).ok, false, "revisión vieja revierte todo el lote");
assert.equal(await prisma.ensayoTarea.count(), 3);
ok(await tareas.remove(prisma, actor, selection), "borrar tareas");
ok(await categorias.remove(prisma, actor, [{ id: hogar.values.id, revision: categoriaRead.values.revision }]), "borrar categoría libre");

// Users without groups and stale sessions are rejected.
for (const denied of [readerActor, { ...actor, sessionVersion: actor.sessionVersion + 1 }]) {
  assert.equal((await categorias.read(prisma, denied, trabajo.values.id)).ok, false);
  assert.equal((await categorias.save(prisma, denied, { name: "No", active: true })).ok, false);
  assert.equal((await categorias.list(prisma, denied, state)).ok, false);
  assert.equal((await categorias.lookup(prisma, denied, { query: "" })).ok, false);
}
assert.equal(await prisma.ensayoCategoria.count({ where: { name: "No" } }), 0);

// Access control: groups, CRUD per model and record rules (usuario ⊂ responsable).
const member = async (login: string, group: string) => {
  const user = await prisma.user.create({ data: { login, password, isAdmin: false, accessGroups: { create: { groupId: group } } } });
  return { id: user.id, sessionVersion: user.sessionVersion };
};
const ana = await member("modules-ana", "ensayo.usuario");
const beto = await member("modules-beto", "ensayo.usuario");
const jefa = await member("modules-jefa", "ensayo.responsable");
const denied = (result: { ok: boolean; error?: string }, label: string) => { assert.equal(result.ok, false, label); assert.match(result.error ?? "", /No tienes permiso|ya no está disponible|cambió|No se encontró/, label); };

// Read-only model for usuario: list yes, create/delete no.
ok(await categorias.list(prisma, ana, state), "usuario lee categorías");
denied(await categorias.save(prisma, ana, { name: "Ajena", active: true }), "usuario no crea categorías");
const taskOf = async (who: typeof ana, name: string) => ok(await tareas.save(prisma, who, { ...base, categoria: trabajo.values.id, name }), `crear ${name}`).values;
const deAna = await taskOf(ana, "De Ana");
const deBeto = await taskOf(beto, "De Beto");
const deJefa = await taskOf(jefa, "De Jefa");
const names = async (who: typeof ana) => (ok(await withActor(who, () => tareas.list(prisma, who, state)), "lista").data.rows.map(row => row.name)).sort();
assert.deepEqual(await names(ana), ["De Ana"], "regla: sólo sus tareas");
assert.deepEqual(await names(jefa), ["De Ana", "De Beto", "De Jefa"], "responsable: reglas de grupo con OR");
assert.deepEqual(await names({ id: admin.id, sessionVersion: admin.sessionVersion }), ["De Ana", "De Beto", "De Jefa"], "superusuario sin reglas");
assert.equal((await tareas.read(prisma, ana, deBeto.id)).ok, false, "registro ajeno se comporta como inexistente");
denied(await tareas.save(prisma, ana, { ...deBeto, name: "Robada" }), "no edita tareas ajenas");
assert.deepEqual(ok(await tareas.lookup(prisma, ana, { query: "" }), "lookup").items.map(item => item.label), ["De Ana"]);
assert.equal((await tareas.activity(prisma, ana, { id: deBeto.id })).ok, false, "actividad ajena");
assert.equal((await tareas.addNote(prisma, ana, { id: deBeto.id, body: "x", requestId: "00000000-0000-4000-8000-000000000002" })).ok, false, "nota ajena");
denied(await tareas.move(prisma, ana, { id: deBeto.id, revision: deBeto.revision, from: "pendiente", to: "curso" }), "mover ajena");
ok(await tareas.move(prisma, ana, { id: deAna.id, revision: deAna.revision, from: "pendiente", to: "curso" }), "mover propia");
const anaNow = ok(await tareas.read(prisma, ana, deAna.id), "leer propia").values;
denied(await tareas.remove(prisma, ana, [{ id: anaNow.id, revision: anaNow.revision }]), "usuario sin unlink");
assert.equal(await prisma.ensayoTarea.count({ where: { id: deBeto.id, name: "De Beto" } }), 1);

// Database override: grant unlink to usuario; the rule still limits it to own tasks.
await prisma.accessModelOverride.create({ data: { groupId: "ensayo.usuario", model: "ensayo.tarea", read: true, create: true, write: true, unlink: true } });
denied(await tareas.remove(prisma, ana, [{ id: deBeto.id, revision: deBeto.revision }]), "override no salta la regla");
ok(await tareas.remove(prisma, ana, [{ id: anaNow.id, revision: anaNow.revision }]), "override permite borrar la propia");
// Override can also remove access entirely.
await prisma.accessModelOverride.update({ where: { groupId_model: { groupId: "ensayo.usuario", model: "ensayo.tarea" } }, data: { read: false } });
denied(await withActor(beto, () => tareas.list(prisma, beto, state)), "override sin lectura");
await prisma.accessModelOverride.delete({ where: { groupId_model: { groupId: "ensayo.usuario", model: "ensayo.tarea" } } });

// Disabling a rule in the database: usuario then sees every task.
await prisma.accessRuleState.create({ data: { ruleId: "ensayo.tareas-propias", active: false } });
assert.deepEqual(await names(beto), ["De Beto", "De Jefa"]);
await prisma.accessRuleState.update({ where: { ruleId: "ensayo.tareas-propias" }, data: { active: true } });
assert.deepEqual(await names(beto), ["De Beto"]);

// Implied groups: with its own rule off, responsable keeps usuario's rule (OR of the remaining ones).
await prisma.accessRuleState.create({ data: { ruleId: "ensayo.tareas-todas", active: false } });
assert.deepEqual(await names(jefa), ["De Jefa"], "responsable hereda la regla de usuario si se apaga la suya");
await prisma.accessRuleState.delete({ where: { ruleId: "ensayo.tareas-todas" } });
const remaining = ok(await withActor(jefa, () => tareas.list(prisma, jefa, state)), "lista final").data.rows.map(row => ({ id: row.id, revision: row.revision! }));
ok(await tareas.remove(prisma, jefa, remaining), "responsable borra todas");
assert.equal(await prisma.ensayoTarea.count(), 0);

// Access administration (Control de accesos): superuser only, ids checked against the code catalog.
const { accessOverview, groupDetail, setGroupMembers, setModelAccess, setRulesActive } = await import("./src/lib/access/admin");
const root = { id: admin.id, sessionVersion: admin.sessionVersion };
await assert.rejects(accessOverview(prisma, ana), /administrador/);
await assert.rejects(setGroupMembers(prisma, ana, "ensayo.usuario", [ana.id]), /administrador/);
await assert.rejects(setGroupMembers(prisma, root, "otro.grupo", [ana.id]), /No tienes permiso/);
const overview = await accessOverview(prisma, root);
assert.deepEqual(overview.find(module => module.id === "ensayo")?.groups.map(group => [group.id, group.members]), [["ensayo.usuario", 2], ["ensayo.responsable", 1]]);
await setGroupMembers(prisma, root, "ensayo.usuario", [ana.id]);
assert.deepEqual((await prisma.accessUserGroup.findMany({ where: { groupId: "ensayo.usuario" } })).map(row => row.userId), [ana.id]);
denied(await withActor(beto, () => tareas.list(prisma, beto, state)), "sin grupo tras quitarlo");
const flags = (read: boolean, create: boolean, write: boolean, unlink: boolean) => ({ read, create, write, unlink });
await setModelAccess(prisma, root, "ensayo.usuario", new Map([["ensayo.categoria", flags(true, true, false, false)]]));
assert.equal(await prisma.accessModelOverride.count(), 1);
ok(await categorias.save(prisma, ana, { name: "Creada por Ana", active: true }), "override permite crear categoría");
// Setting the manifest defaults again removes the override instead of storing a copy.
await setModelAccess(prisma, root, "ensayo.usuario", new Map([["ensayo.categoria", flags(true, false, false, false)]]));
assert.equal(await prisma.accessModelOverride.count(), 0);
await setRulesActive(prisma, root, new Map([["ensayo.tareas-propias", false]]));
assert.equal((await prisma.accessRuleState.findUniqueOrThrow({ where: { ruleId: "ensayo.tareas-propias" } })).active, false);
await setRulesActive(prisma, root, new Map([["ensayo.tareas-propias", true]]));
assert.equal(await prisma.accessRuleState.count(), 0, "una regla activa no se guarda");
await assert.rejects(setRulesActive(prisma, root, new Map([["ensayo.inventada", false]])), /Regla inexistente/);
const detail = (await groupDetail(prisma, root, "ensayo.usuario"))!;
assert.deepEqual(detail.rules.map(rule => [rule.id, rule.scope, rule.active]), [["ensayo.tareas-propias", "grupo", true]]);
assert.deepEqual(detail.models.find(model => model.id === "ensayo.tarea")?.perms, flags(true, true, true, false));
assert.equal(await groupDetail(prisma, root, "otro.grupo"), null);

// Native module manager: the source catalogue is readable only by a fresh admin,
// checked against this temporary schema (never public), without evaluating manifests.
const { moduleCatalogue, cataloguePage } = await import("./src/lib/module-manager/service");
const catalogueContext = { root: process.cwd(), schema: new URL(process.env.DATABASE_URL!).searchParams.get("schema")!, registered: new Set(["ensayo", "contactos", "usuarios", "accesos", "modulos", "citas", "flota"]) };
const catalogue = await moduleCatalogue(prisma, root, catalogueContext);
assert.equal(catalogue.find(module => module.id === "ensayo")?.status, "installed");
assert.equal(catalogue.find(module => module.id === "andamio")?.status, "unregistered");
assert.equal(catalogue.find(module => module.id === "disponible")?.status, "available");
assert.equal(catalogue.find(module => module.id === "modulos")?.kind, "manual");
assert.equal(cataloguePage(catalogue, { ...state, query: "ensayo" }).total, 1);
await assert.rejects(moduleCatalogue(prisma, ana, catalogueContext), /administrador/);
await assert.rejects(moduleCatalogue(prisma, { ...root, sessionVersion: root.sessionVersion + 1 }, catalogueContext), /sesión/);
await prisma.$disconnect();
console.log("modules-check ok");
