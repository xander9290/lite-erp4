import assert from "node:assert/strict";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { modelService, modelClientConfig, getModule, withActor } = await import("./src/lib/modules/registry");
const { hashPassword, verifyPassword } = await import("./src/lib/auth/password");
const { loadOwnProfile, saveOwnProfile } = await import("./src/lib/auth/profile-service");
const password = await hashPassword("core-test-only");
const admin = await prisma.user.create({ data: { login: "core-admin", name: "Admin de prueba", password, isAdmin: true } });
const reader = await prisma.user.create({ data: { login: "core-reader", name: "Lectora", password } });
const actor = { id: admin.id, sessionVersion: admin.sessionVersion }, lector = { id: reader.id, sessionVersion: reader.sessionVersion };
type Saved = Record<string, unknown> & { id: string; revision: string };
const ok = <T extends { ok: boolean }>(result: T, step: string) => { assert.ok(result.ok, `${step}: ${JSON.stringify(result)}`); return result as T & { values: Saved }; };
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };
try {
  assert.deepEqual(getModule("core")?.models.map(model => model.id), ["core.user"]);
  assert.throws(() => modelService("core.partner"));
  const users = modelService("core.user");
  const input = { login: "  Nueva.Cuenta ", name: "Nueva cuenta", email: "nueva@example.com", phone: "", avatarUrl: null, password: "secreta-123", active: true, isAdmin: false, lastLogin: null, empresa: null };
  const countContacts = () => prisma.$queryRawUnsafe(`SELECT count(*) FROM "${new URL(process.env.DATABASE_URL!).searchParams.get("schema")}".partners`);
  const before = await countContacts();
  const nuevo = ok(await users.save(prisma, actor, input), "crear usuario autónomo");
  assert.equal(nuevo.values.login, "nueva.cuenta");
  assert.equal(nuevo.values.password, null);
  assert.equal(Object.hasOwn(nuevo.values, "legacyPartnerId"), false);
  const stored = await prisma.user.findUniqueOrThrow({ where: { id: nuevo.values.id } });
  assert.equal(await verifyPassword("secreta-123", stored.password), true);
  assert.equal(stored.name, "Nueva cuenta"); assert.equal(stored.legacyPartnerId, null);
  for (const patch of [{ login: "otra", password: "" }, { login: "core-admin" }, { login: "correo", email: "incorrecto" }]) assert.equal((await users.save(prisma, actor, { ...input, ...patch })).ok, false);
  const edited = ok(await users.save(prisma, actor, { ...nuevo.values, password: "", isAdmin: true, name: "Cuenta editada", empresa: "ACME", lastLogin: "2000-01-01T00:00:00.000Z" }), "editar usuario y extensión");
  const after = await prisma.user.findUniqueOrThrow({ where: { id: stored.id } });
  assert.equal(after.password, stored.password); assert.equal(after.sessionVersion, stored.sessionVersion + 1); assert.equal(after.lastLogin, null);
  assert.equal(after.name, "Cuenta editada");
  assert.equal((await prisma.crmCoreUser.findUniqueOrThrow({ where: { recordId: stored.id } })).empresa, "ACME");
  const same = ok(await users.save(prisma, actor, { ...edited.values, phone: "777" }), "editar perfil");
  assert.equal((await prisma.user.findUniqueOrThrow({ where: { id: stored.id } })).sessionVersion, after.sessionVersion);
  const clientes = modelService("ventas.cliente");
  ok(await clientes.save(prisma, actor, { name: "Cliente 1", contactoId: reader.id, responsableId: reader.id }), "relaciones a User");
  const page = await withActor(actor, () => clientes.list(prisma, actor, state));
  assert.ok(page.ok); assert.equal(page.data.rows[0].$labels?.responsableId.label, "Lectora");
  assert.deepEqual(modelClientConfig("ventas.cliente").lookups, { contactoId: "core.user", responsableId: "core.user" });
  const self = ok(await users.read(prisma, actor, admin.id), "propia cuenta");
  assert.equal((await users.save(prisma, actor, { ...self.values, isAdmin: false })).ok, false);
  assert.equal((await users.remove(prisma, actor, [{ id: admin.id, revision: self.values.revision }])).ok, false);
  ok(await users.save(prisma, actor, { ...same.values, isAdmin: false }), "quitar admin a otra cuenta");
  assert.equal((await users.read(prisma, lector, admin.id)).ok, false);
  const accounts = await withActor(actor, () => users.list(prisma, actor, state)); assert.ok(accounts.ok);
  assert.ok(accounts.data.rows.every(row => !Object.hasOwn(row, "password") && !Object.hasOwn(row, "legacyPartnerId") && !Object.hasOwn(row, "sessionVersion")));
  const search = await withActor(actor, () => users.list(prisma, actor, { ...state, query: "editada" })); assert.ok(search.ok); assert.equal(search.data.total, 1);
  const profile = await loadOwnProfile(prisma, lector);
  const account = ok(await users.read(prisma, actor, reader.id), "cuenta antes del perfil");
  ok(await saveOwnProfile(prisma, lector, { ...profile.values, phone: "123" }), "guardar perfil");
  assert.equal((await users.save(prisma, actor, { ...account.values, phone: "obsoleto" })).ok, false);
  assert.equal((await saveOwnProfile(prisma, lector, profile.values)).ok, false);
  const profileAgain = await loadOwnProfile(prisma, lector);
  const accountAgain = ok(await users.read(prisma, actor, reader.id), "cuenta para carrera");
  const results = await Promise.all([saveOwnProfile(prisma, lector, { ...profileAgain.values, phone: "456" }), users.save(prisma, actor, { ...accountAgain.values, phone: "789" })]);
  assert.equal(results.filter(result => result.ok).length, 1);
  assert.equal((await prisma.user.findUniqueOrThrow({ where: { id: reader.id } })).sessionVersion, reader.sessionVersion);
  assert.deepEqual(await countContacts(), before);
  console.log("✓ User autónomo: altas sin contactos, perfil local, permisos, contraseñas, sesiones, concurrencia, relaciones y extensión transaccional.");
} finally { await prisma.$disconnect(); }
