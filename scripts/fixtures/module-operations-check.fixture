import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { access, readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { config } from "dotenv";
import { Client } from "pg";
import type { ModuleOperationPlan, OperationResult } from "./src/lib/module-manager/operation.types";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { hashPassword } = await import("./src/lib/auth/password");
const { moduleCatalogue } = await import("./src/lib/module-manager/service");
const { assertNoModuleMaintenance } = await import("./src/lib/module-manager/maintenance");
const database = new Client({ connectionString: process.env.DATABASE_URL });
await database.connect();
const schema = new URL(process.env.DATABASE_URL!).searchParams.get("schema")!;
assert.match(schema, /^modules_test_[a-f0-9]+$/);
const quote = (value: string) => `"${value.replaceAll('"', '""')}"`;
const table = `${quote(schema)}."ciclo_item"`;
const admin = await prisma.user.create({ data: { login: "operations-admin", password: await hashPassword("fixture-only"), isAdmin: true } });
const reader = await prisma.user.create({ data: { login: "operations-reader", password: await hashPassword("fixture-only") } });
const actor = { id: admin.id, sessionVersion: admin.sessionVersion };
const node = (file: string, args: string[] = []) => {
  const result = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", file, ...args], { cwd: process.cwd(), env: process.env, encoding: "utf8", timeout: 120000 });
  assert.equal(result.status, 0, `${result.stdout}\n${result.stderr}`);
  return result.stdout;
};
const request = (body: Record<string, unknown>, user = actor, environment: Record<string, string> = {}): OperationResult => {
  const result = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", "scripts/module-operation.ts", "--worker"], { cwd: process.cwd(), env: { ...process.env, ...environment }, input: JSON.stringify({ ...body, actor: user }), encoding: "utf8", timeout: 300000 });
  if (result.error) throw result.error;
  const marker = result.stdout.lastIndexOf("MODULE_OPERATION_RESULT:");
  assert.ok(marker >= 0, result.stdout + result.stderr);
  return JSON.parse(result.stdout.slice(marker + "MODULE_OPERATION_RESULT:".length).trim());
};
const successful = (result: OperationResult) => { assert.ok(result.ok, JSON.stringify(result)); return result.plan; };
const review = (operation: "install" | "update" | "uninstall", policy: "keep" | "drop" = "keep") => successful(request({ command: "review", input: { module: "ciclo", operation, policy } }));
const apply = (plan: ModuleOperationPlan, confirmation = "ciclo") => successful(request({ command: "apply", id: plan.id, fingerprint: plan.fingerprint, confirmedModule: confirmation, maintenanceConfirmed: true }));
const finish = (plan: ModuleOperationPlan) => successful(request({ command: "finish", id: plan.id, maintenanceConfirmed: true }));
const exists = (path: string) => access(path).then(() => true, () => false);

try {
  if (!process.argv.includes("--legacy-only")) {
  node("scripts/create-module.ts", ["ciclo"]); node("scripts/create-model.ts", ["ciclo", "Item"]);
  const source = join(process.cwd(), "src/modules/ciclo/models/item.ts");
  const initial = await readFile(source, "utf8");
  const before = (await database.query(`SELECT COUNT(*)::text AS n FROM ${quote(schema)}.users`)).rows[0].n;
  const denied = request({ command: "review", input: { module: "ciclo", operation: "install", policy: "keep" } }, { id: reader.id, sessionVersion: reader.sessionVersion });
  assert.equal(denied.ok, false);
  let plan = review("install");
  assert.deepEqual(plan.blockers, []); assert.match(plan.sql, /CREATE TABLE "ciclo_item"/);
  assert.equal(await readFile(source, "utf8"), initial);
  assert.equal((await database.query("SELECT to_regclass($1) AS name", [`${schema}.ciclo_item`])).rows[0].name, null);
  await writeFile(source, `${initial}\n// Personalización posterior al plan\n`);
  assert.equal(request({ command: "apply", id: plan.id, fingerprint: plan.fingerprint, confirmedModule: "ciclo", maintenanceConfirmed: true }).ok, false, "plan obsoleto");
  assert.equal(await exists(".module-operations/maintenance.json"), false);
  plan = review("install");
  assert.equal(request({ command: "apply", id: plan.id, fingerprint: plan.fingerprint, confirmedModule: "otro", maintenanceConfirmed: true }).ok, false);
  // Tampered executable SQL from a JSON file is ignored, not trusted.
  const path = `.module-operations/${plan.id}.json`;
  const stored = JSON.parse(await readFile(path, "utf8")); stored.view.sql = "DROP TABLE users;"; await writeFile(path, JSON.stringify(stored));
  plan = apply(plan); assert.equal(plan.phase, "complete");
  assert.equal((await database.query(`SELECT COUNT(*)::text AS n FROM ${quote(schema)}.users`)).rows[0].n, before);
  await assert.rejects(assertNoModuleMaintenance(), /mantenimiento/);
  const blockedGenerator = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", "scripts/create-module.ts", "bloqueado", "--dry-run"], { encoding: "utf8", timeout: 30000 });
  assert.equal(blockedGenerator.status, 1); assert.match(blockedGenerator.stderr, /mantenimiento/);
  assert.equal(apply(plan).phase, "complete", "repetir no vuelve a aplicar SQL");
  finish(plan); await assertNoModuleMaintenance();
  await database.query(`INSERT INTO ${table} (id,name,active) VALUES ('preserved','Registro conservado',true)`);
  await writeFile(source, (await readFile(source, "utf8")).replace("  // Define aquí", '  notes = Fields.Text({maxLength:80});\n  // Define aquí'));
  plan = review("update"); assert.deepEqual(plan.blockers, []); assert.match(plan.sql, /ADD COLUMN\s+"notes"/);
  plan = apply(plan); finish(plan);
  assert.deepEqual((await database.query(`SELECT name,notes FROM ${table} WHERE id='preserved'`)).rows, [{ name: "Registro conservado", notes: null }]);
  const protectedPlan = successful(request({ command: "review", input: { module: "usuarios", operation: "uninstall", policy: "drop" } }));
  assert.ok(protectedPlan.blockers.length > 0);
  plan = review("uninstall"); assert.deepEqual(plan.blockers, []); assert.equal(plan.sql, "");
  plan = apply(plan); finish(plan);
  assert.equal(await exists("src/modules/ciclo/manifest.ts"), false);
  assert.equal((await database.query(`SELECT name FROM ${table}`)).rows[0].name, "Registro conservado");
  const catalogue = await moduleCatalogue(prisma, actor, { root: process.cwd(), schema, registered: new Set(["ensayo", "modulos", "usuarios", "contactos", "accesos", "citas", "flota"]) });
  assert.equal(catalogue.find(item => item.id === "ciclo")?.status, "retained");
  const reserved = spawnSync(process.execPath, ["--conditions=react-server", "--import", "tsx", "scripts/create-module.ts", "ciclo", "--dry-run"], { encoding: "utf8", timeout: 30000 });
  assert.equal(reserved.status, 1); assert.match(reserved.stderr, /conserva datos/);
  plan = review("install"); assert.deepEqual(plan.blockers, []); assert.equal(plan.sql, "");
  plan = apply(plan); finish(plan);
  assert.equal(await exists("src/modules/ciclo/manifest.ts"), true);
  assert.deepEqual((await database.query(`SELECT name,notes FROM ${table} WHERE id='preserved'`)).rows, [{ name: "Registro conservado", notes: null }]);
  plan = review("uninstall"); assert.deepEqual(plan.blockers, []); plan = apply(plan); finish(plan);
  // A native view is an undeclared database dependent and blocks destructive DDL.
  await database.query(`CREATE VIEW ${quote(schema)}.cycle_dependency AS SELECT id FROM ${table}`);
  plan = review("uninstall", "drop"); assert.ok(plan.blockers.some(value => value.includes("vista")));
  await database.query(`DROP VIEW ${quote(schema)}.cycle_dependency`);
  plan = review("uninstall", "drop"); assert.deepEqual(plan.blockers, []); assert.match(plan.sql, /DROP TABLE "ciclo_item"/);
  const noBackup = request({ command: "apply", id: plan.id, fingerprint: plan.fingerprint, confirmedModule: "ciclo", maintenanceConfirmed: true }, actor, { MODULE_MANAGER_PG_BIN: join(process.cwd(), "missing-pg-tools") });
  assert.equal(noBackup.ok, false);
  const failed = successful(request({ command: "status", id: plan.id }));
  assert.equal(failed.phase, "failed"); assert.equal(failed.canFinish, true);
  assert.equal((await database.query(`SELECT COUNT(*)::text AS count FROM ${table}`)).rows[0].count, "1");
  finish(failed); await assertNoModuleMaintenance();
  plan = review("uninstall", "drop"); assert.deepEqual(plan.blockers, []);
  plan = apply(plan); assert.equal(plan.phase, "complete"); finish(plan);
  assert.equal((await database.query("SELECT to_regclass($1) AS name", [`${schema}.ciclo_item`])).rows[0].name, null);
  assert.equal((JSON.parse(await readFile("prisma/.orm-installations.json", "utf8"))).modules.ciclo, undefined);
  assert.equal(await exists(`.module-operations/backup-${plan.id}/verified.json`), true, "respaldo restaurado antes de eliminar");
  node("scripts/create-module.ts", ["ciclo", "--dry-run"]);
  assert.equal((await database.query(`SELECT COUNT(*)::text AS n FROM ${quote(schema)}.users`)).rows[0].n, before);
  }
  // The previous scaffold has static routes and generated contracts/bindings.
  // Exercise its adapter independently of the real Flota tutorial.
  node("scripts/create-app.ts", ["Ensayoheredado"]);
  const legacyReview = (operation: "install" | "uninstall") => successful(request({ command: "review", input: { module: "ensayoheredado", operation, policy: "keep" } }));
  let legacy = legacyReview("install"); assert.deepEqual(legacy.blockers, []);
  legacy = apply(legacy, "ensayoheredado"); finish(legacy);
  const legacyTable = `${quote(schema)}."ensayoheredado_records"`;
  await database.query(`INSERT INTO ${legacyTable} (id,name,active) VALUES ('legacy-preserved','Registro heredado',true)`);
  legacy = legacyReview("uninstall"); assert.deepEqual(legacy.blockers, []);
  legacy = apply(legacy, "ensayoheredado"); finish(legacy);
  assert.equal(await exists("src/app/(auth)/erp/ensayoheredado/manifest.ts"), false);
  assert.equal((await database.query(`SELECT name FROM ${legacyTable}`)).rows[0].name, "Registro heredado");
  legacy = legacyReview("install"); assert.deepEqual(legacy.blockers, []); assert.equal(legacy.sql, "");
  legacy = apply(legacy, "ensayoheredado"); finish(legacy);
  assert.equal(await exists("src/app/(auth)/erp/ensayoheredado/manifest.ts"), true);
  assert.equal((await database.query(`SELECT name FROM ${legacyTable}`)).rows[0].name, "Registro heredado");
  console.log("✓ Operaciones verificadas; scaffold anterior instalado, retirado y reactivado conservando registros.");
} finally { await database.end(); await prisma.$disconnect(); }
