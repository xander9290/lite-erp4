import assert from "node:assert/strict";
import { config } from "dotenv";
import type { FormButtonProps } from "./src/components/ui/form/formActions";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { modelService, modelClientConfig } = await import("./src/lib/modules/registry");
const { hashPassword } = await import("./src/lib/auth/password");
const { executionCount } = await import("./src/modules/parametros/models/ticket");
const { ParametrosTicketActions } = await import("./src/generated/orm/actions/parametros/ParametrosTicket.actions");
const typedButton: FormButtonProps = { action: ParametrosTicketActions.cerrar };
// @ts-expect-error Generated contracts reject misspelled action names.
const typoButton: FormButtonProps = { action: ParametrosTicketActions.cerra };
// @ts-expect-error FormButton rejects arbitrary text.
const rawButton: FormButtonProps = { action: "cerrar" };
void [typedButton, typoButton, rawButton];
const password = await hashPassword("params-test-only");
const root = await prisma.user.create({ data: { login: "params-root", password, isAdmin: true } });
const operator = await prisma.user.create({ data: { login: "params-operator", password } });
const reader = await prisma.user.create({ data: { login: "params-reader", password } });
const denied = await prisma.user.create({ data: { login: "params-no-action", password } });
await prisma.accessUserGroup.createMany({ data: [{ userId: operator.id, groupId: "parametros.operador" }, { userId: reader.id, groupId: "parametros.consulta" }, { userId: denied.id, groupId: "parametros.sinaccion" }] });
const actor = { id: operator.id, sessionVersion: operator.sessionVersion }, admin = { id: root.id, sessionVersion: root.sessionVersion }, readonly = { id: reader.id, sessionVersion: reader.sessionVersion }, noAction = { id: denied.id, sessionVersion: denied.sessionVersion };
const service = modelService("parametros.ticket");
const technician = await prisma.parametrosTecnico.create({ data: { name: "Visible" } }), hidden = await prisma.parametrosTecnico.create({ data: { name: "Hidden", active: false } });
const saved = await service.save(prisma, actor, { name: "Ticket", estado: "draft", resolucion: null, tecnicoId: null }); assert.ok(saved.ok, JSON.stringify(saved));
let row = saved.values;
const params = (nota = " Listo ") => ({ nota, tecnicoId: technician.id });
const run = (input: unknown, who = actor) => service.action(prisma, who, input);
const request = (input: unknown) => ({ action: ParametrosTicketActions.cerrar.name, id: row.id, revision: row.revision, params: input });
const fail = async (input: unknown, who = actor, methodRuns = false) => {
  const before = await prisma.parametrosTicket.findMany({ orderBy: { id: "asc" } }), logs = await prisma.recordActivity.count(), calls = executionCount();
  const result = await run(input, who); assert.equal(result.ok, false, JSON.stringify(result));
  assert.deepEqual(await prisma.parametrosTicket.findMany({ orderBy: { id: "asc" } }), before); assert.equal(await prisma.recordActivity.count(), logs);
  assert.equal(executionCount(), calls + (methodRuns ? 1 : 0)); return result;
};
for (const input of [undefined, null, [], { ...params(), nota: "" }, { ...params(), cantidad: 0 }, { ...params(), urgente: "yes" }, { ...params(), resultado: "forged" }, { ...params(), fecha: "tomorrow" }, { ...params(), actor: "forged" }, params("x".repeat(17000)), { ...params(), tecnicoId: "missing" }, { ...params(), tecnicoId: hidden.id }]) {
  const result = await fail(request(input)); assert.ok(!result.ok && result.kind === "validation");
}
await fail({ ...request(params()), action: ParametrosTicketActions.cerrar });
await fail({ ...request(params()), action: "normalize" });
await fail({ ...request(params()), revision: "2000-01-01T00:00:00.000Z" });
await fail(request(params()), readonly); await fail(request({ nota: "" }), noAction);
const outsider = await service.save(prisma, admin, { name: "Admin", estado: "draft", resolucion: null, tecnicoId: null }); assert.ok(outsider.ok);
await fail({ ...request(params()), id: outsider.values.id, revision: outsider.values.revision });
for (const nota of ["hook", "late", "business"]) {
  const result = await fail(request(params(nota)), actor, true);
  if (nota === "business") assert.ok(!result.ok && result.parameterErrors?.nota && !result.fieldErrors);
}
const outcome = await run(request(params())); assert.ok(outcome.ok, JSON.stringify(outcome)); row = outcome.values;
assert.equal(row.estado, "closed"); assert.equal(row.resolucion, "Listo"); assert.equal(row.tecnicoId, technician.id);
assert.equal((await prisma.parametrosTicket.findUniqueOrThrow({ where: { id: row.id } })).resolucion, "Listo");
assert.equal(await prisma.recordActivity.count({ where: { recordId: row.id, body: "Cerrar" } }), 1);
const client = modelClientConfig("parametros.ticket");
assert.equal(ParametrosTicketActions.cerrar.model, client.name);
assert.equal(client.actions.find(action => action.name === "cerrar")?.lookups?.tecnicoId, "parametros.tecnico");
assert.ok(!JSON.stringify(client.actions).includes('"schema"'));
await fail({ action: "legacy", id: row.id, revision: row.revision, params: { nota: "unexpected" } });
const legacy = await run({ action: "legacy", id: row.id, revision: row.revision }); assert.ok(legacy.ok, JSON.stringify(legacy));
await prisma.user.update({ where: { id: operator.id }, data: { active: false } });
await fail({ ...request(params()), revision: legacy.values.revision });
console.log("✓ Parámetros: strict Fields/defaults, immutable context, target access, groups, rules, stale revision, legacy signature, business errors, hooks/history and full rollback.");
await prisma.$disconnect();
