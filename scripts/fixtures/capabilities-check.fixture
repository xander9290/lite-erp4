import assert from "node:assert/strict";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const { prisma } = await import("./src/lib/prisma");
const { readAccessCapabilities } = await import("./src/lib/access/engine");
const { modelClientConfig, modelService, getModuleModel, withActor, relationLookup } = await import("./src/lib/modules/registry");
const { setGroupMembers, setFieldRestrictions, setActionRestrictions, setMenuVisibility, groupDetail } = await import("./src/lib/access/admin");
const { applicationNavigation, firstApplicationMenu } = await import("./src/lib/applications/navigation");
const { canOpenApplication } = await import("./src/lib/applications/manifest");
const { prepareRegisteredFormOpen } = await import("./src/lib/modules/form-open.server");
const { hashPassword } = await import("./src/lib/auth/password");

// Only copied/executed in the disposable project/schema by modules.integration.ts.
const password = await hashPassword("capabilities-test-only");
const adminUser = await prisma.user.create({ data: { login: "caps-admin", password, isAdmin: true } });
const readerUser = await prisma.user.create({ data: { login: "caps-reader", password } });
const managerUser = await prisma.user.create({ data: { login: "caps-manager", password } });
const admin = { id: adminUser.id, sessionVersion: adminUser.sessionVersion };
const reader = { id: readerUser.id, sessionVersion: readerUser.sessionVersion };
const manager = { id: managerUser.id, sessionVersion: managerUser.sessionVersion };
await prisma.accessUserGroup.createMany({ data: [{ userId: reader.id, groupId: "ensayo.usuario" }, { userId: manager.id, groupId: "ensayo.responsable" }] });
await assert.rejects(setGroupMembers(prisma, admin, "ensayo.responsable", [manager.id, reader.id]), /dos grupos/);
const raceUser = await prisma.user.create({ data: { login: "caps-membership-race", password } });
const assignments = await Promise.allSettled([
  setGroupMembers(prisma, admin, "ensayo.usuario", [reader.id, raceUser.id]),
  setGroupMembers(prisma, admin, "ensayo.responsable", [manager.id, raceUser.id]),
]);
assert.equal(assignments.filter(result => result.status === "fulfilled").length, 1, "only one concurrent job assignment may commit");
assert.equal(await prisma.accessUserGroup.count({ where: { userId: raceUser.id } }), 1);
await setGroupMembers(prisma, admin, "ensayo.usuario", [reader.id]);
await setGroupMembers(prisma, admin, "ensayo.responsable", [manager.id]);
const snapshot = (actor: typeof admin) => prisma.$transaction(tx => readAccessCapabilities(tx, actor), { isolationLevel: "RepeatableRead" });
const tasks = modelService("ensayo.tarea");
const categories = modelService("ensayo.categoria");
const category = await categories.save(prisma, admin, { name: "Catálogo de capacidades", active: true });
assert.ok(category.ok);
const entry = getModuleModel("ensayo.tarea")!;
const record = await tasks.save(prisma, reader, { ...entry.entry.contract.createDefaults(), name: "Tarea propia", categoria: category.values.id });
assert.ok(record.ok);
// Opening a form is read-only, validates origins/default relations and preserves saved revisions.
const openRequest = { model: "ensayo.tarea", view: "modal" };
const opened = await prepareRegisteredFormOpen({ ...openRequest, defaults: { name: "Propuesta", categoria: category.values.id }, origin: { model: "ensayo.tarea", id: record.values.id } }, reader);
assert.equal(opened.defaults.categoria, category.values.id);
assert.equal(opened.config.id, "ensayo.tarea");
await assert.rejects(prepareRegisteredFormOpen({ ...openRequest, defaults: { categoria: "missing-reference" } }, reader));
await assert.rejects(prepareRegisteredFormOpen({ ...openRequest, origin: { model: "ensayo.tarea", id: "missing-origin" } }, reader));
await assert.rejects(prepareRegisteredFormOpen({ model: "unregistered.item", view: "modal" }, admin));
const application = { ...entry.module.application, icon: (() => null) as never };
const state = { query: "", sort: "name", direction: "asc" as const, page: 1, pageSize: 10, filters: [] };

// Menu visibility is an independent navigation policy: no loss of CRUD, references or URL access.
const group = await groupDetail(prisma, admin, "ensayo.usuario");
assert.ok(group?.menus.some(menu => menu.id === "tarea-list"));
const beforeMenus = await snapshot(reader);
await setMenuVisibility(prisma, admin, "ensayo.usuario", [{ application: "ensayo", menu: "tarea-list", hidden: true }]);
const hiddenTask = await snapshot(reader);
assert.deepEqual(hiddenTask.modelAccess, beforeMenus.modelAccess);
assert.equal(firstApplicationMenu(applicationNavigation(application, hiddenTask)!.menus)?.id, "categoria-list");
assert.equal((await tasks.read(prisma, reader, record.values.id)).ok, true);
assert.equal((await relationLookup("ensayo.tarea", "categoria", reader, { request: { ids: [category.values.id] }, draft: {} })).ok, true);
assert.equal(canOpenApplication(application, hiddenTask), true);
assert.equal(applicationNavigation(application, await snapshot(admin))!.menus.length, 2, "admin bypasses hidden menus");
assert.equal((await snapshot(manager)).hiddenMenus?.some(menu => menu.application === "ensayo" && menu.menu === "tarea-list"), true, "implication accumulates menu exceptions");
await assert.rejects(setMenuVisibility(prisma, reader, "ensayo.usuario", [{ application: "ensayo", menu: "tarea-list", hidden: false }]), /administrador/);
await assert.rejects(setMenuVisibility(prisma, admin, "ensayo.usuario", [{ application: "contactos", menu: "contacts", hidden: true }]), /permiso/);
await setMenuVisibility(prisma, admin, "ensayo.usuario", [{ application: "ensayo", menu: "configuracion-group", hidden: true }]);
assert.deepEqual(applicationNavigation(application, await snapshot(reader))!.menus, []);
await setMenuVisibility(prisma, admin, "ensayo.usuario", [{ application: "ensayo", menu: "tarea-list", hidden: false }]);
assert.deepEqual(applicationNavigation(application, await snapshot(reader))!.menus.map(menu => menu.id), ["tarea-list"], "unmarking does not delete other exceptions");
await setMenuVisibility(prisma, admin, "ensayo.usuario", [{ application: "ensayo", menu: "configuracion-group", hidden: false }]);

await prisma.accessModelOverride.create({ data: { groupId: "ensayo.usuario", model: "ensayo.tarea", read: true, create: false, write: false, unlink: false } });
const readonlyAccess = await snapshot(reader);
const readonlyConfig = modelClientConfig("ensayo.tarea", readonlyAccess);
assert.deepEqual(readonlyConfig.capabilities, { read: true, create: false, write: false, unlink: false, move: false });
assert.deepEqual(readonlyConfig.actions, []);
const readonlyOpened = await prepareRegisteredFormOpen({ ...openRequest, id: record.values.id, defaults: { name: "Ignore" } }, reader);
assert.equal(readonlyOpened.config.capabilities?.write, false);
assert.deepEqual(readonlyOpened.defaults, {});
await assert.rejects(prepareRegisteredFormOpen(openRequest, reader));

assert.deepEqual(readonlyConfig.kanbanTransitions, []);
assert.ok((await tasks.read(prisma, reader, record.values.id)).ok);
assert.ok((await withActor(reader, () => tasks.list(prisma, reader, state))).ok);
assert.equal((await tasks.save(prisma, reader, { ...record.values, name: "Intento falsificado" })).ok, false);
assert.equal((await tasks.save(prisma, reader, { ...entry.entry.contract.createDefaults(), name: "Nuevo denegado", categoria: category.values.id })).ok, false);
assert.equal((await tasks.action(prisma, reader, { action: "iniciar", id: record.values.id, revision: record.values.revision })).ok, false);
assert.equal((await tasks.move(prisma, reader, { id: record.values.id, revision: record.values.revision, from: "pendiente", to: "curso" })).ok, false);
assert.equal((await tasks.remove(prisma, reader, [{ id: record.values.id, revision: record.values.revision }])).ok, false);
const unchanged = await tasks.read(prisma, admin, record.values.id);
assert.ok(unchanged.ok);
assert.equal(unchanged.values.revision, record.values.revision);

const responsible = modelClientConfig("ensayo.tarea", await snapshot(manager));
assert.equal(responsible.capabilities?.write, true, "another inherited group grants write despite an override on usuario");
assert.equal(responsible.capabilities?.unlink, true);
assert.ok(responsible.actions.some(action => action.name === "reabrir"));
const superuser = modelClientConfig("ensayo.tarea", await snapshot(admin));
assert.equal(superuser.capabilities?.create, true);

// Policies are re-read per request; protected required fields survive partial saves.
const privatePolicy = { noRead: true, noWrite: true, invisible: false, readOnly: false };
await setFieldRestrictions(prisma, admin, "ensayo.responsable", [{ model: "ensayo.tarea", field: "name", policy: privatePolicy }]);
const privateRead = await tasks.read(prisma, manager, record.values.id);
assert.ok(privateRead.ok, JSON.stringify(privateRead));
assert.equal(Object.hasOwn(privateRead.values, "name"), false);
assert.equal(privateRead.displayName, record.values.id);
const privateUI = modelClientConfig("ensayo.tarea", await snapshot(manager));
assert.equal(privateUI.fieldAccess?.name.noRead, true);
assert.deepEqual(privateUI.actions, []);
assert.equal(privateUI.capabilities?.move, false);
const privateSave = await tasks.save(prisma, manager, { ...privateRead.values });
assert.ok(privateSave.ok, JSON.stringify(privateSave));
assert.equal(Object.hasOwn(privateSave.values, "name"), false);
const privateStored = await tasks.read(prisma, admin, record.values.id);
assert.ok(privateStored.ok);
assert.equal(privateStored.values.name, "Tarea propia");
assert.equal((await tasks.save(prisma, manager, { ...privateSave.values, name: "Tarea propia" })).ok, false, "even a correct private guess is rejected");
assert.equal((await withActor(manager, () => tasks.list(prisma, manager, state))).ok, false, "private sorting is denied");
const safeList = await withActor(manager, () => tasks.list(prisma, manager, { ...state, sort: "id" }));
assert.ok(safeList.ok, JSON.stringify(safeList));
assert.equal(JSON.stringify(safeList).includes("Tarea propia"), false);
assert.equal((await tasks.action(prisma, manager, { action: "iniciar", id: record.values.id, revision: privateSave.values.revision })).ok, false);
await setFieldRestrictions(prisma, admin, "ensayo.responsable", [{ model: "ensayo.tarea", field: "name", policy: { ...privatePolicy, noRead: false, noWrite: false } }]);
await setActionRestrictions(prisma, admin, "ensayo.responsable", [{ model: "ensayo.tarea", action: "iniciar", blocked: true }]);
assert.equal(modelClientConfig("ensayo.tarea", await snapshot(manager)).actions.some(action => action.name === "iniciar"), false);
assert.equal((await tasks.action(prisma, manager, { action: "iniciar", id: record.values.id, revision: privateSave.values.revision })).ok, false);
await setActionRestrictions(prisma, admin, "ensayo.responsable", [{ model: "ensayo.tarea", action: "iniciar", blocked: false }]);
assert.equal((await tasks.read(prisma, manager, record.values.id)).ok, true);

await prisma.accessModelOverride.create({ data: { groupId: "ensayo.usuario", model: "ensayo.categoria", read: false, create: false, write: false, unlink: false } });
const withoutCatalog = await snapshot(reader);
assert.deepEqual(applicationNavigation(application, withoutCatalog)?.menus.map(menu => menu.id), ["tarea-list"]);
assert.equal((await categories.read(prisma, reader, category.values.id)).ok, false);
const relational = await relationLookup("ensayo.tarea", "categoria", reader, { request: { ids: [category.values.id] }, draft: {} });
assert.equal(relational.ok, true);
assert.deepEqual(relational.items.map(item => item.value), [category.values.id], "published relation remains usable without direct catalog read");
assert.deepEqual(relational.items[0].record, { id: category.values.id }, "minimal relational projection");
await assert.rejects(relationLookup("ensayo.tarea", "password", reader, { request: {}, draft: {} }), /publicada/);
await prisma.accessModelOverride.updateMany({ where: { groupId: "ensayo.usuario", model: "ensayo.tarea" }, data: { read: false } });
assert.equal(canOpenApplication(application, await snapshot(reader)), false);
assert.equal((await tasks.read(prisma, reader, record.values.id)).ok, false);
await prisma.accessModelOverride.updateMany({ where: { groupId: "ensayo.usuario", model: "ensayo.categoria" }, data: { read: true } });
assert.deepEqual(applicationNavigation(application, await snapshot(reader))?.menus.map(menu => menu.id), ["configuracion-group"]);
await prisma.accessUserGroup.deleteMany({ where: { userId: reader.id } });
assert.equal(canOpenApplication(application, await snapshot(reader)), false);
await prisma.user.update({ where: { id: manager.id }, data: { sessionVersion: { increment: 1 } } });
await assert.rejects(snapshot(manager), /sesión/);
await assert.rejects(prepareRegisteredFormOpen({ ...openRequest, id: record.values.id }, manager));
await prisma.user.update({ where: { id: reader.id }, data: { active: false } });
await assert.rejects(snapshot(reader), /sesión/);
await assert.rejects(prepareRegisteredFormOpen(openRequest, reader));
await prisma.$disconnect();
