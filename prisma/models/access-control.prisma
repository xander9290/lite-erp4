// Access control for declarative modules. Groups, model access and record rules are
// declared in module manifests (code); these tables only store what an administrator
// changes: user memberships, model access overrides, rule activation and opt-in policies.

model AccessUserGroup {
  userId    String   @map("user_id")
  user      User     @relation("AccessUserGroup_user", fields: [userId], references: [id], onDelete: Cascade)
  /** `<module>.<group>` as declared in a manifest. */
  groupId   String   @map("group_id") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("access_user_groups")
}

model AccessModelOverride {
  groupId   String   @map("group_id") @db.VarChar(120)
  /** `<module>.<model>` public model id. */
  model     String   @db.VarChar(120)
  read      Boolean
  create    Boolean
  write     Boolean
  unlink    Boolean
  canImport Boolean @default(false) @map("can_import")
  canExport Boolean @default(false) @map("can_export")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([groupId, model])
  @@map("access_model_overrides")
}

model AccessRuleState {
  /** `<module>.<rule>` as declared in a manifest. */
  ruleId    String   @id @map("rule_id") @db.VarChar(120)
  active    Boolean
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("access_rule_states")
}

// Opt-in restrictions; absence preserves the model's normal behavior.
model AccessFieldRestriction {
  groupId String @map("group_id") @db.VarChar(120)
  model String @db.VarChar(120)
  field String @db.VarChar(120)
  noRead Boolean @default(false) @map("no_read")
  noWrite Boolean @default(false) @map("no_write")
  invisible Boolean @default(false)
  readOnly Boolean @default(false) @map("read_only")
  @@id([groupId, model, field])
  @@map("access_field_restrictions")
}

model AccessActionRestriction {
  groupId String @map("group_id") @db.VarChar(120)
  model String @db.VarChar(120)
  action String @db.VarChar(120)
  @@id([groupId, model, action])
  @@map("access_action_restrictions")
}

// Navigation exceptions. The module/app registry owns IDs; no business permission is changed.
model AccessMenuHidden {
  groupId String @map("group_id") @db.VarChar(120)
  application String @db.VarChar(120)
  menu String @db.VarChar(120)
  @@id([groupId, application, menu])
  @@map("access_menu_hidden")
}

// Form presentation exceptions: Notebook pages declared in a model's `pages` catalog.
// Hiding a page never changes field/data permissions or validation.
model AccessPageHidden {
  groupId String @map("group_id") @db.VarChar(120)
  model String @db.VarChar(120)
  screen String @db.VarChar(60)
  layout String @db.VarChar(10)
  notebook String @db.VarChar(60)
  page String @db.VarChar(60)
  @@id([groupId, model, screen, layout, notebook, page])
  @@map("access_page_hidden")
}
