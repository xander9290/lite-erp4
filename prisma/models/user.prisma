model User {
    id        String    @id @default(cuid())
    login     String    @unique
    password  String
    lastLogin DateTime? @map("last_login")
    active Boolean @default(true)
    isAdmin Boolean @default(false) @map("is_admin")
    darkMode Boolean @default(false) @map("dark_mode")
    sessionVersion Int @default(0) @map("session_version")

    partnerId String?  @unique @map("partner_id")
    partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
    recordActivities RecordActivity[] @relation("RecordActivity_actor")
    accessGroups AccessUserGroup[] @relation("AccessUserGroup_user")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

    @@map("users")

  // BEGIN lite-erp:demo:User
  demoTareaCreatedRecords DemoTarea[] @relation("DemoTarea_createBy")
  demoCategoriaCreatedRecords DemoCategoria[] @relation("DemoCategoria_createBy")
  // END lite-erp:demo:User
}
