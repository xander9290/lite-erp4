model User {
    id        String    @id @default(cuid())
    login     String    @unique
    password  String
    lastLogin DateTime? @map("last_login")
    active Boolean @default(true)
    isAdmin Boolean @default(false) @map("is_admin")
    darkMode Boolean @default(false) @map("dark_mode")
    sessionVersion Int @default(0) @map("session_version")

    name String @default("")
    email String?
    phone String?
    avatarUrl String? @map("avatar_url")
    // Historical link only. Not a relation or an editable/published model field.
    legacyPartnerId String? @unique(map: "users_partner_id_key") @map("partner_id")
    recordActivities RecordActivity[] @relation("RecordActivity_actor")
    accessGroups AccessUserGroup[] @relation("AccessUserGroup_user")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

    @@map("users")

  // BEGIN lite-erp:ubicaciones:User
  ubicacionesPaisCreatedRecords UbicacionesPais[] @relation("UbicacionesPais_createBy")
  ubicacionesEstadoCreatedRecords UbicacionesEstado[] @relation("UbicacionesEstado_createBy")
  ubicacionesMunicipioCreatedRecords UbicacionesMunicipio[] @relation("UbicacionesMunicipio_createBy")
  ubicacionesLocalidadCreatedRecords UbicacionesLocalidad[] @relation("UbicacionesLocalidad_createBy")
  // END lite-erp:ubicaciones:User

  // BEGIN lite-erp:directory:User
  directoryPartnerSaleUserIdRecords DirectoryPartner[] @relation("DirectoryPartner_saleUserId")
  directoryPartnerPurchaseUserIdRecords DirectoryPartner[] @relation("DirectoryPartner_purchaseUserId")
  directoryPartnerCreatedRecords DirectoryPartner[] @relation("DirectoryPartner_createBy")
  directoryPartnertagsCreatedRecords DirectoryPartnertags[] @relation("DirectoryPartnertags_createBy")
  directoryBusinessactivityCreatedRecords DirectoryBusinessactivity[] @relation("DirectoryBusinessactivity_createBy")
  directoryPartneremailsCreatedRecords DirectoryPartneremails[] @relation("DirectoryPartneremails_createBy")
  directoryPartnerphonesCreatedRecords DirectoryPartnerphones[] @relation("DirectoryPartnerphones_createBy")
  directoryCoreUserRecordIdRecords DirectoryCoreUser? @relation("DirectoryCoreUser_recordId")
  directoryCoreUserCreatedRecords DirectoryCoreUser[] @relation("DirectoryCoreUser_createBy")
  // END lite-erp:directory:User
}
