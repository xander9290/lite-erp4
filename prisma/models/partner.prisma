model Partner {
    id    String  @id @default(cuid())
    name  String
    email String?
    phone String?
    avatarUrl String? @map("avatar_url")

    user User?

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

    @@index([name])
    @@map("partners")

  // BEGIN lite-erp:contactosextra:Partner
  contactosextraCorePartnerRecordIdRecords ContactosextraCorePartner? @relation("ContactosextraCorePartner_recordId")
  // END lite-erp:contactosextra:Partner
}
