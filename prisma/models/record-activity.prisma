// Shared infrastructure for declarative model services. Access is always scoped
// by the service's fixed model name and an authorized, existing record.
model RecordActivity {
  id        String   @id @default(cuid())
  model     String   @db.VarChar(100)
  recordId  String   @map("record_id") @db.VarChar(100)
  kind      String   @db.VarChar(10)
  actorId   String   @map("actor_id")
  actor     User     @relation("RecordActivity_actor", fields: [actorId], references: [id], onDelete: Restrict)
  body      String?  @db.VarChar(4000)
  changes   Json     @default("[]")
  requestId String?  @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorId, requestId])
  @@index([model, recordId, createdAt, id])
  @@map("record_activities")
}
