{
  "name": "lite-erp4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "test:auth": "node --import tsx --test src/lib/auth/auth.test.ts",
    "test:form-navigation": "node --import tsx --test src/components/ui/form/unsavedChanges.test.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx scripts/auth.integration.ts",
    "test:theme:integration": "node --conditions=react-server --import tsx scripts/theme.integration.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nextjs-nav-guard": "^1.1.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-image-crop": "^11.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "^5.7.50",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
