{
  "name": "lite-erp4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "test:auth": "node --import tsx --test src/lib/auth/auth.test.ts",
    "test:form-navigation": "node --import tsx --test src/components/ui/form/unsavedChanges.test.ts src/components/ui/form/formDeletion.test.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx scripts/auth.integration.ts",
    "test:theme:integration": "node --conditions=react-server --import tsx scripts/theme.integration.ts",
    "test:applications": "node --import tsx --test src/lib/applications/manifest.test.ts",
    "test:contacts": "node --conditions=react-server --import tsx --test \"src/app/(auth)/erp/contactos/schemas/contact.schema.test.ts\" \"src/app/(auth)/erp/contactos/models/partner.test.ts\"",
    "test:contacts:integration": "node --conditions=react-server --import tsx scripts/contacts.integration.ts",
    "test:appointments": "node --conditions=react-server --import tsx --test \"src/app/(auth)/erp/citas/schemas/*.test.ts\" \"src/app/(auth)/erp/citas/models/*.test.ts\" src/lib/prisma-connection.test.ts",
    "test:appointments:integration": "node --conditions=react-server --import tsx scripts/appointments.integration.ts",
    "test:appointments:service": "node --conditions=react-server --import tsx scripts/appointments-service.integration.ts",
    "test:orm": "node --conditions=react-server --import tsx --test src/lib/orm/*.test.ts",
    "test:images": "node --conditions=react-server --import tsx --test src/lib/orm/image.test.ts src/lib/uploads/model-image.test.ts src/components/ui/form/imageProcessing.test.mjs",
    "orm:generate": "node --conditions=react-server --import tsx scripts/orm-generate.ts",
    "orm:install": "node --conditions=react-server --import tsx scripts/orm-install.ts",
    "orm:bind": "node --conditions=react-server --import tsx scripts/orm-bind.ts",
    "orm:sync": "node --conditions=react-server --import tsx scripts/orm-sync.ts",
    "test:orm:install": "node --conditions=react-server --import tsx --test src/lib/orm/generator/*.test.ts",
    "create:app": "node --conditions=react-server --import tsx scripts/create-app.ts",
    "create:model": "node --conditions=react-server --import tsx scripts/create-model.ts",
    "create:views": "node --conditions=react-server --import tsx scripts/create-views.ts",
    "test:scaffold": "node --conditions=react-server --import tsx --test src/lib/scaffold/*.test.ts",
    "test:framework:integration": "node --conditions=react-server --import tsx scripts/framework.integration.ts",
    "test:views": "node --conditions=react-server --import tsx --test src/lib/kanban/*.test.ts",
    "test:list-selection": "node --conditions=react-server --import tsx --test src/components/ui/list/listSelection.test.ts src/lib/list/delete.test.ts",
    "test:list-grouping": "node --conditions=react-server --import tsx --test src/lib/list/grouping.test.ts src/lib/orm/service.test.ts",
    "update:views": "node --conditions=react-server --import tsx scripts/update-views.ts",
    "test:form-model": "node --import tsx --test src/components/ui/form/modelFields.test.tsx src/components/ui/form/modelReactionEngine.test.ts",
    "benchmark:reactions": "node --conditions=react-server --import tsx scripts/benchmark-reactions.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^7.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nextjs-nav-guard": "^1.1.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-image-crop": "^11.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "^5.7.50",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
